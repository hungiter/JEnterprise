            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>3.2.4</version> <!-- hoặc phiên bản bạn dùng -->
                <type>pom</type>
                <scope>import</scope>
            </dependency>

