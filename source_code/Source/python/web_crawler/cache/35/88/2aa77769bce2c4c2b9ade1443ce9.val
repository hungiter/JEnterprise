Thanh toán sau\",\"paymentInvoice\":\"Hóa đơn thanh toán\",\"paymentInvoiceRequest\":\"Tôi muốn xuất hóa đơn\",\"shippingContact\":\"Thông tin giao hàng\",\"shippingContactSameWContact\":\"Tôi muốn sử dụng thông tin liên hệ trên!\",\"success\":\"Đặt tour thành công\",\"successQuote1\":\"Cảm ơn Quý khách đã tin tưởng và đặt tour bên Vietravel. Chúc quý khách có một chuyến đi chơi thật vui vẻ và nhiều kỷ niệm.\",\"successQuote2\":\"Để xem thông tin đặt tour, Quý khách vui lòng truy cập vào email đã nhập trên Vietravel để xem thông tin.\",\"summaryTitle\":\"Tóm tắt chuyến đi\",\"title\":\"Hoàn tất\",\"tour\":\"Đặt tour\"},\"pageHome\":{\"comboGoodPrice\":\"Combo giá tốt\",\"comboGoodPriceSubQuote\":\" Với sự hợp tác giảm giá ưu đãi cùng hệ thống đối tác lớn, chúng tôi tự tin mang đến cho quý khách combo vé máy bay và khách sạn với giá tốt nhất!\",\"comboTabAll\":\"Tất cả\",\"comboTabFlightHotel\":\"Máy bay + Khách sạn\",\"comboTabTransportHotel\":\"Xe + Khách sạn\",\"experienceApp\":\"Trải nghiệm ứng dụng điện thoại\",\"experienceAppQuote\":\"Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.\",\"explore\":\"Khám phá sản phẩm vietravel\",\"exploreQuote\":\"Hãy tận hưởng trải nghiệm du lịch chuyên nghiệp, mang lại cho bạn những khoảnh khắc tuyệt vời và nâng tầm cuộc sống. Chúng tôi cam kết mang đến những chuyến đi đáng nhớ, giúp bạn khám phá thế giới theo cách hoàn hảo nhất.\",\"favoriteLocation\":\"Điểm đến yêu thích\",\"favoriteLocationSubQuote\":\"Hãy chọn một điểm đến du lịch nổi tiếng dưới đây để khám phá các chuyến đi độc quyền của chúng tôi với mức giá vô cùng hợp lý.\",\"lastDeal\":\"Ưu đãi giờ chót\",\"lastDealSubQuote\":\"Nhanh tay nắm bắt cơ hội giảm giá cuối cùng. Đặt ngay để không bỏ lỡ!\",\"ownDiscount\":\"Khuyến mãi có hạn dành riêng cho bạn\",\"ownDiscountCountDonwn\":\"Chương trình sẽ kết thúc trong\",\"ownDiscountSubQuote\":\"Đây là những tour có ưu đãi đặc biệt dành riêng cho quý khách. Hãy đặt và thanh toán ngay để nhận được ưu đãi!\"},\"payment\":{\"agreeAndCountinuePayment\":\"Đồng ý và tiếp tục thanh toán\",\"autoSwitchToOrderBookingPage\":\"Vietravel sẽ tự động chuyển sang trang theo dõi đơn hàng sau {seconds} giây\",\"cancelPayment\":\"Hủy thanh toán\",\"errorWhenProcess\":\"Có lỗi xảy ra trong quá trình thanh toán. Vui lòng thử lại sau!\",\"iHaveReadAndClearlyUnderstood\":\"Tôi đã đọc và hiểu rõ các nội dung trên\",\"paymentFailed\":\"Thanh toán thất bại\",\"paymentSuccess\":\"Thanh toán thành công\",\"repayment\":\"Thanh toán lại\",\"verifyingYouPaymentInfo\":\"Chúng tôi đang xác nhận thông tin thanh toán của bạn...\",\"weWillAutoSwitchIfConfirmSuccess\":\"Vietravel sẽ tự động chuyển sang trang theo dõi đơn hàng sau khi xác nhận thành công. Vui lòng đợi trong giây lát.\"},\"personalPromotion\":{\"dateGo\":\"Ngày đi\",\"departure\":\"Khởi hành\",\"discount\":\"Ưu đãi\",\"gatheringPlace\":\"Tập trung\",\"hotel\":\"Khách sạn\",\"lastHour\":\"Giờ chót\",\"seatLeft\":\"Số chỗ còn  nhận\",\"sightseeingSpot\":\"Điểm tham quan\",\"timeGo\":\"Thời gian\",\"tourCode\":\"Mã tour\",\"transportation\":\"Phương tiện\"},\"promoTourDescription\":{\"LM\":\"Du lịch giờ chót của Vietravel luôn đem đến cho Quý khách những niềm bất ngờ thú vị. Đó là những đường tour cuốn hút với mức giá đầy hấp dẫn, khuyến mại vào thời điểm cận ngày khởi hành. Với những giảm giá rất ưu đãi phối hợp với hệ thống đối tác lớn mạnh, Vietravel cho Quý khách cơ hội được tận hưởng những dịch vụ chất lượng vàng không đổi từ công ty lữ hành uy tín nhất Việt Nam.\"},\"search\":{\"adult\":\"Người lớn\",\"adultAge\":\"Từ {min} trở lên\",\"adultCap\":\"Người lớn\",\"adultRule\":\"Cao trên 140cm\",\"airlineTickets\":\"Vé máy bay\",\"airplane-hotel\":\"Combo Vé máy bay - Khách sạn\",\"arrivedDay\":\"Ngày đến\",\"arrivedDayPlaceholder\":\"Chọn ngày đến\",\"carHotel\":\"Xe - Khách sạn\",\"carHotelCombo\":\"Combo Xe - Khách sạn\",\"checkIn\":\"Nhận phòng\",\"checkInOut\":\"Nhận - trả phòng\",\"checkOut\":\"Trả phòng\",\"children\":\"Trẻ em\",\"childrenAge\":\"Từ {min} - {max} tuổi\",\"childrenCap\":\"Trẻ em\",\"childRule\":\"Cao từ 100cm-140cm\",\"city-airport\":\"Thành phố, sân bay\",\"combo\":\"Combo\",\"comboGoodPrice\":\"Combo giá tốt\",\"departureDay\":\"Ngày đi\",\"departureDayPlaceholder\":\"Chọn ngày đi\",\"destinationSuggestionLabel\":\"Điểm đến Quý khách có thể tìm kiếm\",\"discount\":\"Giảm giá\",\"elective\":\"Tự chọn\",\"electiveCombo\":\"Combo tự chọn\",\"flightHotelCombo\":\"Combo Vé máy bay - Khách sạn\",\"from\":\"Từ\",\"guestNo\":\"Số khách\",\"holidayTour\":\"Tour ngày lễ\",\"hotel\":\"Khách sạn\",\"hotelsDestinationsCities\":\"Khách sạn, điểm đến, thành phố,...\",\"infant\":\"Em bé\",\"infantAge\":\"Dưới {max} tuổi\",\"infantCap\":\"Em bé\",\"infants\":\"trẻ sơ sinh\",\"infantsCap\":\"Trẻ sơ sinh\",\"lastDeal\":\"Deal giờ chót\",\"lastMinuteTour\":\"Tour giờ chót\",\"location\":\"Địa điểm\",\"lookUpReservations\":\"Tra cứu booking\",\"lookUpReservationsPlaceholder\":\"Nhập số booking của Quý khách\",\"oneWay\":\"Một chiều\",\"otherService\":\"Dịch vụ khác\",\"otherServiceCat\":{\"foodExperiences\":\"Trải nghiệm ẩm thực\",\"gameActivities\":\"Trò chơi và hoạt động\",\"transportation\":\"Phương tiện di chuyển\",\"travelExperiences\":\"Trải nghiệm du lịch\"},\"otherServiceType\":{\"admissionTicket\":\"Vé tham quan\",\"carRental\":\"Thuê xe\",\"restaurant\":\"Nhà hàng\",\"simCard\":\"Thẻ SIM\",\"tourGuide\":\"Hướng dẫn viên\",\"trainTicket\":\"Vé xe lửa\"},\"packageTour\":\"Tour trọn gói\",\"placeholderSearchTour\":\"Tìm kiếm với bất kỳ địa danh bạn yêu thích!; Đà Nẵng; Nhật Bản; Pháp; Mỹ\",\"promotion\":\"Khuyến mãi\",\"province-station\":\"Tỉnh thành, Ga tàu\",\"returnDay\":\"Ngày trở về\",\"returnDayPlaceholder\":\"Chọn ngày trở về\",\"room\":\"Phòng\",\"roomCap\":\"Phòng\",\"roomNo\":\"Số phòng\",\"roundTrip\":\"Khứ hồi\",\"search\":\"Tìm kiếm\",\"searchForBooking\":\"Tra cứu Booking\",\"searchForInformation\":\"Tìm kiếm thông t