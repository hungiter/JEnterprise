19:T8dc,"])</script><script>self.__next_f.push([1,"\u003cp class=\"ql-align-justify\"\u003eQuý khách tập trung tại sân bay Tân Sơn Nhất (ga trong nước), hướng dẫn viên làm thủ tục cho Quý khách đáp chuyến bay đi Hà Nội. Đến sân bay Nội Bài, xe đón đoàn khởi hành đi Mộc Châu (Sơn La) trên đường dừng tham quan:\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cstrong\u003eBảo tàng lịch sử quân sự\u003c/strong\u003e - khám phá không gian trưng bày ấn tượng với các hiện vật quân sự độc đáo, máy bay, xe tăng, và Tháp Cờ Hà Nội - biểu tượng thiêng liêng giữa lòng thủ đô. Nơi đây mang đến cái nhìn tổng quan về chặng đường phát triển của quân đội Việt Nam qua từng thời kỳ.\u003c/li\u003e\u003cli\u003eChụp hình \u003cstrong\u003eđèo Thung Khe\u003c/strong\u003e hay còn gọi là \u003cstrong\u003eđèo Đá Trắng\u003c/strong\u003e, nơi đây quanh năm trắng như tuyết và mây mù bao phủ tạo cảnh quan tuyệt đep thu hút nhiều du khách đến chụp ảnh.\u003c/li\u003e\u003cli\u003e\u003cstrong style=\"background-color: white;\"\u003eQuần thể phức hợp vui chơi giải trí và nghỉ dưỡng Mộc Châu Island \u003c/strong\u003e\u003cspan style=\"background-color: white;\"\u003echiêm ngưỡng vẻ đẹp \u003c/span\u003e\u003cstrong style=\"background-color: white;\"\u003eCầu kính Bạch Long\u003c/strong\u003e\u003cspan style=\"background-color: white;\"\u003e có chiều dài 632m, ở độ cao cách mặt đất 150m, là “Cây cầu kính đi bộ dài nhất thế giới” được xác lập kỷ\u003c/span\u003e lục Guinness vào tháng 28/5/2022. Trải nghiệm các trò chơi: Chinh phục cầu kính Bạch Long, trượt Airslide, zipline, Mộc Châu Space,… \u003cem\u003e(chi phí tự túc).\u003c/em\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp class=\"ql-align-justify\"\u003eQuý khách nhận phòng khách sạn nghỉ ngơi. Buổi tối, Quý khách có thể tự do tham quan \u003cstrong\u003ekhu phố Nhật Bản\u003c/strong\u003e - với nhiều khu vực khác nhau mang đậm phong cách Nhật Bản như: khu quảng trường; Sakura Café, trà đạo phong cách Nhật,… tham gia các hoạt động cuối tuần tại \u003cstrong\u003ePhố đi bộ Mộc Châu\u003c/strong\u003e hoặc tận hưởng không khí thanh bình vùng cao nguyên với tách trà nóng đậm đà.\u003c/p\u003e\u003cp class=\"ql-align-right\"\u003e\u003cstrong\u003eNghỉ đêm tại Mộc Châu\u003c/strong\u003e\u003c/p\u003e"])</script><script>self.__next_f.push([1,"1a:T6fb,\u003cp class=\"ql-align-justify\"\u003eSau khi ăn sáng và làm thủ tục trả phòng, Quý khách tham quan: \u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cstrong\u003eBảo tàng Chiến thắng lịch sử Điện Biên Phủ: \u003c/strong\u003etrưng bày hơn 1.000 tư liệu hình ảnh, tài liệu, hiện vật, cảnh tượng lịch sử tái hiện lại cuộc chiến hào hùng của quân và dân ta trong Chiến dịch Điện Biên Phủ năm 1954.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eChiêm ngưỡng kiệt tác bức tranh Panorama toàn cảnh “Trận chiến Điện Biên Phủ” \u003c/strong\u003esống động\u003cstrong\u003e: \u003c/strong\u003eTái hiện chân thực những khoảnh khắc điển hình nhất trong Chiến dịch Điện Biên Phủ.\u003c/li\u003e\u003cli\u003eNgắm cầu Mường Thanh, sông Nậm Rốm và con đường hoa ban trong trung tâm thành phố.\u003c/li\u003e\u003cli\u003eTham quan và mua sắm đặc sản \u003cstrong\u003eQuà Tây Bắc Điện Biên\u003c/strong\u003e về làm quà cho người thân và gia đình như gạo Điện Biên, mật ong, sâu chít, thịt trâu hun khói, chẳm chéo, măng, các sản phẩm mây tre đan, các sản phẩm thêu, dệt thổ cẩm,..\u003c/li\u003e\u003c/ul\u003e\u003cp class=\"ql-align-justify\"\u003eQuý khách khởi hành đi Lai Châu, trên đường ngắm cảnh rừng núi Tây Bắc dọc theo dòng sông Nậm Na và vùng ngập nước do đập nhà máy Thủy điện Sơn La dâng lên tại ngã ba sông: sông Đà, sông Nậm Na và sông Nậm Rốm.\u003c/p\u003e\u003cp class=\"ql-align-justify\"\u003eQuý khách dùng cơm chiều và nhận phòng khách sạn nghỉ ngơi. Buổi tối, quý khách tự do khám phá, thưởng trà và ngắm toàn cảnh thành phố Lai Châu về đêm tại Tam Đường Tea \u003cem\u003e(chi phí tự túc).\u003c/em\u003e\u003c/p\u003e\u003cp class=\"ql-align-right\"\u003e\u003cstrong\u003eNghỉ đêm tại Lai Châu\u003c/strong\u003e\u003c/p\u003e1b:Tcae,"])</script><script>self.__next_f.push([1,"\u003cp class=\"ql-align-justify\"\u003e\u003cspan style=\"color: black;\"\u003eQuý khách dùng điểm tâm sáng và làm thủ tục trả phòng. Xe đưa Quý khách \u003c/span\u003echinh phục đèo \u003cstrong\u003eÔ Quy Hồ\u003c/strong\u003e - con đèo đẹp, hùng vĩ và dài nhất trong Tứ Đại Đỉnh Đèo miền Bắc.\u003c/p\u003e\u003cp class=\"ql-align-justify\"\u003eĐến với thanh phố trong sương Sapa, Quý khách tham quan \u003cstrong\u003ekhu du lịch Fansipan Legend\u003c/strong\u003e \u003cspan style=\"color: rgb(34, 34, 34);\"\u003ethưởng ngoạn bức tranh phong cảnh đầy màu sắc của cánh rừng nguyên sinh, thung lũng Mường Hoa.\u003c/span\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cspan style=\"color: rgb(34, 34, 34);\"\u003eChinh phục đỉnh núi Fansipan với độ cao 3.143m hùng vĩ bằng cáp treo \u003c/span\u003e\u003cem style=\"color: rgb(34, 34, 34);\"\u003e(chi phí tự túc).\u003c/em\u003e\u003c/li\u003e\u003cli\u003e\u003cspan style=\"color: rgb(34, 34, 34);\"\u003eLễ Phật tại \u003c/span\u003e\u003cstrong style=\"color: rgb(34, 34, 34);\"\u003echùa Trình\u003c/strong\u003e\u003cspan style=\"color: rgb(34, 34, 34);\"\u003e hay cầu phúc lộc, bình an cho gia đình tại \u003c/span\u003e\u003cstrong style=\"color: rgb(34, 34, 34);\"\u003eBích Vân Thiền Tự\u003c/strong\u003e\u003cspan style=\"color: rgb(34, 34, 34);\"\u003e trong hệ thống cảnh quan tâm linh trên đỉnh Fansipan.\u003c/span\u003e\u003c/li\u003e\u003cli\u003e\u003cstrong style=\"color: rgb(34, 34, 34);\"\u003eTrải nghiệm tuyến tàu lửa Mường Hoa hiện đại nhất Việt Nam\u003c/strong\u003e\u003cspan style=\"color: rgb(34, 34, 34);\"\u003e.\u003c/span\u003e\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eBản Cát Cát\u003c/strong\u003e - Thăm những nếp nhà của người Mông, Dao, Giáy trong bản, tại đây du khách sẽ không khỏi ngỡ ngàng trước vẻ đẹp của một trong những ngôi làng cổ đẹp nhất Sapa và có dịp được thưởng thức chương trình biểu diễn văn nghệ của người H\u0026#39;Mông\u003cspan style=\"color: rgb(0, 112, 192);\"\u003e \u003c/span\u003e\u003cem\u003e(chương trình văn nghệ diễn ra vào các thời điểm cố định trong ngày). \u003c/em\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp class=\"ql-align-justify\"\u003eQuý khách dùng cơm chiều và nhận phòng khách sạn nghỉ ngơi.\u003c/p\u003e\u003cp class=\"ql-align-justify\"\u003eBuổi tối Quý khách tự do dạo phố, ngắm\u003cstrong\u003e nhà thờ Đá Sapa\u003c/strong\u003e và thưởng thức đặc sản vùng cao tại \u003cstrong\u003eChợ đêm Sapa\u003c/strong\u003e như: \u003cem\u003ethịt lợn cắp nách nướng, trứng nướng, rượu táo mèo,… \u003c/em\u003egiao lưu với người dân tộc vùng cao.\u003c/p\u003e\u003cp class=\"ql-align-right\"\u003e\u003cstrong\u003eNghỉ đêm tại Sapa\u003c/strong\u003e\u003c/p\u003e\u003cp class=\"ql-align-justify\"\u003e\u003cstrong style=\"background-color: rgb(252, 253, 253); color: red;\"\u003e\u003cem\u003e\u003cu\u003eLưu ý: \u003c/u\u003e\u003c/em\u003e\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cem style=\"background-color: rgb(252, 253, 253); color: red;\"\u003eTrong trường hợp, Fansipan không hoạt động chương trình sẽ được thay thế bằng điểm tham quan Cầu Kính Rồng Mây (không bao gồm vé tham quan).\u003c/em\u003e\u003c/li\u003e\u003cli\u003e\u003cem style=\"background-color: rgb(252, 253, 253); color: red;\"\u003eChương trình tặng vé trải nghiệm tàu hỏa leo núi Mường Hoa sẽ không được hoàn lại chi phí và không thay thế dịch vụ khác trong trường hợp Quý khách không tham gia hoặc phải hủy do điều kiện khách quan về thời tiết, cung đường, thông báo từ đơn vị cung ứng.\u003c/em\u003e\u003c/li\u003e\u003c/ul\u003e"])</script><script>self.__next_f.push([1,"1c:T641,\u003cp\u003e\u003cspan style=\"color: black;\"\u003eTrả phòng khách sạn, đoàn khởi \u003c/span\u003ehành tham quan \u003cstrong\u003eMù Cang Chải\u003c/strong\u003e, ngang qua:\u003c/p\u003e\u003cul\u003e\u003cli\u003eNgắm\u003cstrong\u003e Bản Lìm Mông \u003c/strong\u003etừ trên cao: đây là Bản của dân tộc Mông và là nơi có ruộng lúa đẹp nhất Mù Cang Chải. Quý khách sẽ bị mê hoặc bởi \u003cspan style=\"color: black;\"\u003evẻ đẹp hút hồn của cung đường ruộng bậc thang nổi tiếng tại 3 xã: La Pán Tẩn, \u003c/span\u003eChế Cu Nha và Zế Xu Phình. Quý khách chiêm ngưỡng những thung lũng rộng hút tầm mắt, các thửa ruộng tầng tầng lớp lớp lượn sóng theo sườn núi, ngọn núi này nối tiếp ngọn núi khác.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eĐèo Khau Phạ\u003c/strong\u003e: đoạn đèo dài nhất trên tuyến quốc lộ 32 được mệnh danh là một trong “tứ đại đỉnh đèo” với độ dài trên 30km.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eTú Lệ: \u003c/strong\u003equý khách sẽ ngửi được mùi hương thoang thoảng theo gió bảng lảng trên mái nhà của “cơm mới”, nơi đây nổi tiếng với xôi nếp, cốm khô.\u003c/li\u003e\u003c/ul\u003e\u003cp class=\"ql-align-justify\"\u003eBuổi tối, Quý khách dùng cơm chiều và thưởng thức chương trình biểu diễn \u003cstrong\u003emúa Xòe\u003c/strong\u003e, giao lưu và tìm hiểu nét văn hóa đặc sắc của dân tộc \u003cspan style=\"color: black;\"\u003eThái \u003c/span\u003e\u003cem style=\"color: red;\"\u003e(chương trình biểu diễn dành tặng cho đoàn từ 20 khách trở lên). \u003c/em\u003e\u003c/p\u003e\u003cp class=\"ql-align-right\"\u003e\u003cstrong\u003eNghỉ đêm tại Nghĩa Lộ\u003c/strong\u003e\u003c/p\u003e1d:T586,\u003cp class=\"ql-align-justify\"\u003eQuý khách ăn sáng và trả phòng. Tiếp tục hành trình đến sân bay Nội Bài, Hướng dẫn viên hỗ trợ Quý khách làm thủ tục đáp chuyến bay về Tp.HCM. Chia tay Quý khách và kết thúc chương trình du lịch tại sân bay Tân Sơn Nhất.\u003cstrong\u003e \u003c/strong\u003e\u003c/p\u003e\u003cp class=\"ql-align-center\"\u003e\u003cstrong\u003e\u003cu\u003eKẾT THÚC CHƯƠNG TRÌNH, CẢM ƠN VÀ TẠM BIỆT QUÝ "])</script><script>self.__next_f.push([1,"KHÁCH!\u003c/u\u003e\u003c/strong\u003e\u003c/p\u003e\u003cp class=\"ql-align-justify\"\u003e\u003c/p\u003e\u003cp class=\"ql-align-justify\"\u003e\u003cstrong style=\"color: rgb(230, 0, 0);\"\u003e\u003cem\u003e\u003cu\u003e*Lưu ý:\u003c/u\u003e\u003c/em\u003e\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cem style=\"color: rgb(230, 0, 0);\"\u003eHành trình có thể thay đổi thứ tự điểm đến tùy vào điều kiện thực tế. \u003c/em\u003e\u003c/li\u003e\u003cli\u003e\u003cem style=\"color: rgb(230, 0, 0);\"\u003eLịch trình tham quan (tắm biển, ngắm hoa, trải nghiệm,...) rất dễ bị ảnh hưởng bởi thời tiết. Đây là trường hợp bất khả kháng mong Quý khách hiểu và thông cảm.\u003c/em\u003e\u003c/li\u003e\u003cli\u003e\u003cem style=\"color: rgb(230, 0, 0);\"\u003eKhách Sạn có thể ở xa trung tâm thành phố vào các mùa Cao Điểm. Cơ cấu phòng sẽ phụ thuộc vào tình hình thực tế của khách sạn khi làm thủ tục nhận phòng. \u003c/em\u003e\u003c/li\u003e\u003cli\u003e\u003cem style=\"color: rgb(230, 0, 0);\"\u003eVietravel hỗ trợ 1 bữa ăn nhẹ tại sân bay đối với các chuyến bay về sau 20:00 tối.\u003c/em\u003e\u003c/li\u003e\u003c/ul\u003e1e:T1b69,"])</script><script>self.__next_f.push([1,"-\tĐối với Khách Quốc tịch Việt Nam: Khi đi tour Trẻ em từ 14 tuổi trở lên và người lớn cần đem theo CCCD/Passport (Hộ chiếu) bản chính còn hạn sử dụng, hình ảnh rõ (CCCD có thời hạn sử dụng không quá 15 năm, tính từ ngày cấp)/ Giấy khai sinh bản chính (trẻ em dưới 14 tuổi), trẻ em trên 14 tuổi bắt buộc phải có CCCD hoặc Passport làm thủ tục lên máy bay.  \u003cbr/\u003e-\tĐối với khách Nước ngoài/Việt Kiều: Khi đi tour phải mang theo đầy đủ Passport (Hộ Chiếu) bản chính còn hạn sử dụng hoặc thẻ xanh kèm theo Visa và giấy tái xuất nhập Việt Nam làm thủ tục lên máy bay.  \u003cbr/\u003e-\tKhi đăng ký tour Quý khách vui lòng mang theo CCCD /Passport bản chính hoặc cung cấp tên chính xác đầy đủ, đúng từng ký tự trên CCCD / Passport (Hộ chiếu)/Giấy khai sinh (trẻ em dưới 14 tuổi) theo thứ tự: Họ/tên lót/tên. Quý khách khi đăng ký cung cấp tên theo giấy tờ tùy thân nào, khi đi tour phải mang theo giấy tờ tùy thân đó theo qui định hãng hàng không \u003cbr/\u003e-\tTrong trường hợp Quý khách cung cấp tên sai, đến trễ giờ bay, vui lòng chịu phí đổi vé hoặc mua lại vé mới theo quy định của Hãng Hàng Không (nếu chuyến bay còn chỗ). \u003cbr/\u003e-\tTrong trường hợp Quý khách bay hãng hàng không Vietjet, vé không hoàn, không dời, đổi, huỷ, sai tên mất 100% theo qui định hãng hàng không. Giá vé máy bay trẻ em bằng 100% người lớn. \u003cbr/\u003e-\tTrong trường hợp Quý khách bay hãng hàng không Vietnam Air. Vé máy bay khuyến mãi không hoàn, không đổi, hủy, sai tên mất 100% theo qui định hãng hàng không. Vé Vietnam Airlines  không bay chặng đi, tự động hủy chặng về.\u003cbr/\u003e-\t Giá vé, giờ bay có thể thay đổi theo Hãng Hàng Không (Vietnam Airlines, Vietjet, Vietravel Airlines) không thể báo trước. \u003cbr/\u003e-\tDo các chuyến bay phụ thuộc vào các hãng Hàng Không nên trong một số trường hợp giờ bay có thể thay đổi mà không được báo trước. Tùy vào tình hình thực tế, Chương trình và điểm tham quan có thể linh động thay đổi thứ tự các điểm phù hợp điều kiện giờ bay và thời tiết thực tế. Vietravel sẽ không chịu trách nhiệm bảo đảm các điểm tham quan trong trường hợp:\u003cbr/\u003eo\tXảy ra thiên tai: bão lụt, hạn hán, động đất…\u003cbr/\u003eo\tSự cố về an ninh: dịch bệnh, khủng bố, biểu tình\u003cbr/\u003eo\tSự cố về hàng không: trục trặc kỹ thuật, an ninh, dời, hủy, hoãn chuyến bay.\u003cbr/\u003e-\tNếu những trường hợp trên xảy ra, Vietravel sẽ xem xét để hoàn trả chi phí không tham quan cho khách trong điều kiện có thể (sau khi đã trừ lại các dịch vụ đã thực hiện… và không chịu trách nhiệm bồi thường thêm bất kỳ chi phí nào khác).\u003cbr/\u003e-\tSau khi Quý khách đã làm thủ tục Hàng Không và nhận thẻ lên máy bay, đề nghị Quý khách giữ cẩn thận và lưu ý lên máy bay đúng giờ. Vietravel không chịu trách nhiệm trong trường hợp khách làm mất thẻ lên máy bay và không lên máy bay đúng theo giờ quy định của Hàng Không.\u003cbr/\u003e-\tGiờ nhận phòng khách sạn: sau 14:00 giờ và trả phòng trước 12:00 giờ   \u003cbr/\u003e-\tPhòng khách sạn/resort có thể xảy ra trường hợp phòng không gần nhau, không cùng tầng, loại phòng một giường đôi hoặc hai giường đơn không theo yêu cầu, tùy tình hình thực tế từng khách sạn/Resort. \u003cbr/\u003e-\tTrường hợp quý khách tham gia tour 01 khách, bắt buộc đóng thêm tiền phụ thu phòng đơn để ở riêng 01 phòng. Trường hợp trong đoàn cũng có khách đi 01 mình, cùng giới tính và có nhu cầu muốn ghép cùng phòng với quý khách thì Vietravel sẽ hoàn lại tiền phụ thu phòng đơn cho quý khách.\u003cbr/\u003e-\tTrường hợp quý khách đi nhóm 03 khách, Vietravel sẽ cung cấp 01 phòng dành cho 03 khách là 01 giường lớn 1m6 và 01 giường phụ di động từ 0.8 - 1,2m (extrabed) hoặc 01 nệm đơn tùy từng khách sạn/Resort. Trong trường quý khách có nhu cầu ở riêng, vui lòng đóng thêm tiền phụ thu phòng đơn theo qui định \u003cbr/\u003e-\tThông tin hành lý khi đi tour : Xách tay dưới 7kg/1khách - Kích thước không quá: 56cm x 36cm x 23 cm, chất lỏng với thể tích không quá 100ml. Ký gửi: 20kg/1khách - Kích thước không quá: 119cm x 119cm x 81cm. Các vật phẩm không được chấp nhận dưới dạng hành lý ký gởi hoặc vận chuyển trong hành lý theo qui định hàng không\u003cbr/\u003e-\tThông tin tập trung : Tại sân bay Tân Sơn Nhất, Ga đi trong nước, trước giờ bay 2 tiếng (áp dụng ngày thường), trước 2 tiếng 30 phút (áp dụng lễ tết), tại cột số 4 Trong trường hợp bay hãng hàng không Vietjet, tại cột 10 trong trường hợp bay hãng hàng không Vietnam, Jetstar. \u003cbr/\u003e-\tQuý khách dưới 18 tuổi khi đi tour phải có Bố Mẹ hoặc người thân trên 18 tuổi đi cùng. Trường hợp đi một mình phải được Bố Mẹ ủy quyền (có xác nhận của chính quyền địa phương) cho Vietravel \u003cbr/\u003e-\tKhách nữ từ 55 tuổi trở lên và khách nam từ 60 trở lên: nên có người thân dưới 55 tuổi (đầy đủ sức khỏe) đi cùng. Riêng khách từ 70 tuổi trở lên: Bắt buộc phải có người thân dưới 55 tuổi (đầy đủ sức khỏe) đi cùng và nộp kèm giấy khám sức khỏe, có xác nhận đủ sức khỏe để đi du lịch của\u003cbr/\u003e       bác sĩ + Giấy cam kết sức khỏe theo mẫu qui định của công ty. Vì lý do an toàn Quý khách hạn chế và không nhận khách từ 80 tuổi trở lên. Khách trên 80 tuổi không có chế độ bảo hiểm.\u003cbr/\u003e-\tQuý khách đang mang thai vui lòng báo cho nhân viên bán tour ngay tại thời điểm đăng ký. Lưu ý phải có ý kiến của bác sĩ trước khi đi tour. Cam kết tự chịu trách nhiệm về sức khỏe của mình và thai nhi trong suốt thời gian tham gia chương trình du lịch. \u003cbr/\u003e-\tQuý khách có nhu cầu cần xuất hóa đơn vui lòng cung cấp thông tin xuất hóa đơn cho nhân viên bán tour khi ngay khi đăng ký, không nhận xuất hóa đơn sau khi tour đã kết thúc. \u003cbr/\u003e-\tQuý khách vui lòng tham khảo kỹ các Điều Kiện Bán Vé trước khi đăng ký chuyến du lịch. Trong trường hợp không trực tiếp đăng ký, nhờ người thân đăng ký hộ vui lòng cập nhật thông tin từ người đăng ký.\u003cbr/\u003e"])</script><script>self.__next_f.push([1,"1f:T27be,"])</script><script>self.__next_f.push([1,"{\"@context\":\"https://schema.org\",\"@type\":\"Product\",\"name\":\"Khám phá Tây Bắc| Hòa Bình - Mộc Châu - Điện Biên - Lai Châu - Sapa - Fansipan - Yên Bái - Hà Nội | Tặng vé tàu hỏa leo núi Mường Hoa\",\"image\":\"https://media.travel.com.vn/Tour/tfd__1_13057_ethnic-minority-children-playing-in-the-plum-blossom-garden-in-full-bloom.webp\",\"category\":\"tour quốc tế\",\"keywords\":\"tour quốc tế\",\"description\":\" Ngày 1: Quý khách tập trung tại sân bay Tân Sơn Nhất (ga trong nước), hướng dẫn viên làm thủ tục cho Quý khách đáp chuyến bay đi Hà Nội. Đến sân bay Nội Bài, xe đón đoàn khởi hành đi Mộc Châu (Sơn La) trên đường dừng tham quan:Bảo tàng lịch sử quân sự - khám phá không gian trưng bày ấn tượng với các hiện vật quân sự độc đáo, máy bay, xe tăng, và Tháp Cờ Hà Nội - biểu tượng thiêng liêng giữa lòng thủ đô. Nơi đây mang đến cái nhìn tổng quan về chặng đường phát triển của quân đội Việt Nam qua từng thời kỳ.Chụp hình đèo Thung Khe hay còn gọi là đèo Đá Trắng, nơi đây quanh năm trắng như tuyết và mây mù bao phủ tạo cảnh quan tuyệt đep thu hút nhiều du khách đến chụp ảnh.Quần thể phức hợp vui chơi giải trí và nghỉ dưỡng Mộc Châu Island chiêm ngưỡng vẻ đẹp Cầu kính Bạch Long có chiều dài 632m, ở độ cao cách mặt đất 150m, là “Cây cầu kính đi bộ dài nhất thế giới” được xác lập kỷ lục Guinness vào tháng 28/5/2022. Trải nghiệm các trò chơi: Chinh phục cầu kính Bạch Long, trượt Airslide, zipline, Mộc Châu Space,… (chi phí tự túc).Quý khách nhận phòng khách sạn nghỉ ngơi. Buổi tối, Quý khách có thể tự do tham quan khu phố Nhật Bản - với nhiều khu vực khác nhau mang đậm phong cách Nhật Bản như: khu quảng trường; Sakura Café, trà đạo phong cách Nhật,… tham gia các hoạt động cuối tuần tại Phố đi bộ Mộc Châu hoặc tận hưởng không khí thanh bình vùng cao nguyên với tách trà nóng đậm đà.Nghỉ đêm tại Mộc Châu Ngày 2: Quý khách dùng bữa sáng và làm thủ tục trả phòng sớm, xe và hướng dẫn viên khởi hành tham quan:Chụp ảnh tại đồi chè trái tim - một trong những đồi chè lớn nhất tại Mộc Châu thu hút rất nhiều sự quan tâm của các tín đồ đam mê chụp ảnh.Tiếp tục hành trình, Quý khách khởi hành đi Điện Biên. Trên đường ngắm Đèo Pha Đin - đây cũng là một trong \\\"tứ đại đèo\\\" vùng Đông Tây Bắc và được xếp cùng nhóm 6 con đèo gây ấn tượng nhất Việt Nam.Quý khách nhận phòng khách sạn và dùng cơm chiều. Buổi tối, Quý khách tự do tham quan Tượng đài chiến thắng Điện Biên Phủ khám phá thành phố Điện Biên về đêm. Nghỉ đêm Tp. Điện Biên Phủ Ngày 3: Sau khi ăn sáng và làm thủ tục trả phòng, Quý khách tham quan: Bảo tàng Chiến thắng lịch sử Điện Biên Phủ: trưng bày hơn 1.000 tư liệu hình ảnh, tài liệu, hiện vật, cảnh tượng lịch sử tái hiện lại cuộc chiến hào hùng của quân và dân ta trong Chiến dịch Điện Biên Phủ năm 1954.Chiêm ngưỡng kiệt tác bức tranh Panorama toàn cảnh “Trận chiến Điện Biên Phủ” sống động: Tái hiện chân thực những khoảnh khắc điển hình nhất trong Chiến dịch Điện Biên Phủ.Ngắm cầu Mường Thanh, sông Nậm Rốm và con đường hoa ban trong trung tâm thành phố.Tham quan và mua sắm đặc sản Quà Tây Bắc Điện Biên về làm quà cho người thân và gia đình như gạo Điện Biên, mật ong, sâu chít, thịt trâu hun khói, chẳm chéo, măng, các sản phẩm mây tre đan, các sản phẩm thêu, dệt thổ cẩm,..Quý khách khởi hành đi Lai Châu, trên đường ngắm cảnh rừng núi Tây Bắc dọc theo dòng sông Nậm Na và vùng ngập nước do đập nhà máy Thủy điện Sơn La dâng lên tại ngã ba sông: sông Đà, sông Nậm Na và sông Nậm Rốm.Quý khách dùng cơm chiều và nhận phòng khách sạn nghỉ ngơi. Buổi tối, quý khách tự do khám phá, thưởng trà và ngắm toàn cảnh thành phố Lai Châu về đêm tại Tam Đường Tea (chi phí tự túc).Nghỉ đêm tại Lai Châu Ngày 4: Quý khách dùng điểm tâm sáng và làm thủ tục trả phòng. Xe đưa Quý khách chinh phục đèo Ô Quy Hồ - con đèo đẹp, hùng vĩ và dài nhất trong Tứ Đại Đỉnh Đèo miền Bắc.Đến với thanh phố trong sương Sapa, Quý khách tham quan khu du lịch Fansipan Legend thưởng ngoạn bức tranh phong cảnh đầy màu sắc của cánh rừng nguyên sinh, thung lũng Mường Hoa.Chinh phục đỉnh núi Fansipan với độ cao 3.143m hùng vĩ bằng cáp treo (chi phí tự túc).Lễ Phật tại chùa Trình hay cầu phúc lộc, bình an cho gia đình tại Bích Vân Thiền Tự trong hệ thống cảnh quan tâm linh trên đỉnh Fansipan.Trải nghiệm tuyến tàu lửa Mường Hoa hiện đại nhất Việt Nam.Bản Cát Cát - Thăm những nếp nhà của người Mông, Dao, Giáy trong bản, tại đây du khách sẽ không khỏi ngỡ ngàng trước vẻ đẹp của một trong những ngôi làng cổ đẹp nhất Sapa và có dịp được thưởng thức chương trình biểu diễn văn nghệ của người H'Mông (chương trình văn nghệ diễn ra vào các thời điểm cố định trong ngày). Quý khách dùng cơm chiều và nhận phòng khách sạn nghỉ ngơi.Buổi tối Quý khách tự do dạo phố, ngắm nhà thờ Đá Sapa và thưởng thức đặc sản vùng cao tại Chợ đêm Sapa như: thịt lợn cắp nách nướng, trứng nướng, rượu táo mèo,… giao lưu với người dân tộc vùng cao.Nghỉ đêm tại SapaLưu ý: Trong trường hợp, Fansipan không hoạt động chương trình sẽ được thay thế bằng điểm tham quan Cầu Kính Rồng Mây (không bao gồm vé tham quan).Chương trình tặng vé trải nghiệm tàu hỏa leo núi Mường Hoa sẽ không được hoàn lại chi phí và không thay thế dịch vụ khác trong trường hợp Quý khách không tham gia hoặc phải hủy do điều kiện khách quan về thời tiết, cung đường, thông báo từ đơn vị cung ứng. Ngày 5: Trả phòng khách sạn, đoàn khởi hành tham quan Mù Cang Chải, ngang qua:Ngắm Bản Lìm Mông từ trên cao: đây là Bản của dân tộc Mông và là nơi có ruộng lúa đẹp nhất Mù Cang Chải. Quý khách sẽ bị mê hoặc bởi vẻ đẹp hút hồn của cung đường ruộng bậc thang nổi tiếng tại 3 xã: La Pán Tẩn, Chế Cu Nha và Zế Xu Phình. Quý khách chiêm ngưỡng những thung lũng rộng hút tầm mắt, các thửa ruộng tầng tầng lớp lớp lượn sóng theo sườn núi, ngọn núi này nối tiếp ngọn núi khác.Đèo Khau Phạ: đoạn đèo dài nhất trên tuyến quốc lộ 32 được mệnh danh là một trong “tứ đại đỉnh đèo” với độ dài trên 30km.Tú Lệ: quý khách sẽ ngửi được mùi hương thoang thoảng theo gió bảng lảng trên mái nhà của “cơm mới”, nơi đây nổi tiếng với xôi nếp, cốm khô.Buổi tối, Quý khách dùng cơm chiều và thưởng thức chương trình biểu diễn múa Xòe, giao lưu và tìm hiểu nét văn hóa đặc sắc của dân tộc Thái (chương trình biểu diễn dành tặng cho đoàn từ 20 khách trở lên). Nghỉ đêm tại Nghĩa Lộ Ngày 6: Quý khách dùng bữa sáng, trả phòng khách sạn và khởi hành tham quan: Đền Hùng: nơi thờ các vua Hùng có công dựng nước, tổ tiên của dân tộc Việt Nam, một quần thể kiến trúc thâm nghiêm trên núi Nghĩa Lĩnh. Quý khách dâng hương đất tổ, thăm quan đền Thượng, đền Trung, đền Hạ, Giếng Ngọc, Lăng vua Hùng.Nghỉ đêm tại Hà Nội Ngày 7: Quý khách ăn sáng và trả phòng. Tiếp tục hành trình đến sân bay Nội Bài, Hướng dẫn viên hỗ trợ Quý khách làm thủ tục đáp chuyến bay về Tp.HCM. Chia tay Quý khách và kết thúc chương trình du lịch tại sân bay Tân Sơn Nhất. KẾT THÚC CHƯƠNG TRÌNH, CẢM ƠN VÀ TẠM BIỆT QUÝ KHÁCH!*Lưu ý:Hành trình có thể thay đổi thứ tự điểm đến tùy vào điều kiện thực tế. Lịch trình tham quan (tắm biển, ngắm hoa, trải nghiệm,...) rất dễ bị ảnh hưởng bởi thời tiết. Đây là trường hợp bất khả kháng mong Quý khách hiểu và thông cảm.Khách Sạn có thể ở xa trung tâm thành phố vào các mùa Cao Điểm. Cơ cấu phòng sẽ phụ thuộc vào tình hình thực tế của khách sạn khi làm thủ tục nhận phòng. Vietravel hỗ trợ 1 bữa ăn nhẹ tại sân bay đối với các chuyến bay về sau 20:00 tối.\",\"productID\":\"13057\",\"sku\":\"NDSGN1722\",\"slogan\":\"Du lịch giá hấp dẫn cùng Vietravel\",\"brand\":{\"@type\":\"Brand\",\"name\":\"Vietravel\"},\"offers\":{\"@type\":\"Offer\",\"url\":\"https://localhost:3727/chuong-trinh/kham-pha-tay-bac-hoa-binh-moc-chau-ien-bien-lai-chau-sapa-fansipan-yen-bai-ha-noi-tang-ve-tau-hoa-leo-nui-muong-hoa-pid-13057\",\"priceCurrency\":\"VND\",\"price\":10690000,\"itemCondition\":\"https://schema.org/NewCondition\",\"availability\":\"https://schema.org/InStock\",\"seller\":{\"@type\":\"Organization\",\"name\":\"Vietravel\"}},\"review\":{\"@type\":\"Review\",\"reviewRating\":{\"@type\":\"Rating\",\"ratingValue\":0,\"bestRating\":\"5\"},\"author\":{\"@type\":\"Person\",\"name\":\"Vietravel\"}},\"aggregateRating\":{\"@type\":\"AggregateRating\",\"ratingValue\":0,\"reviewCount\":276}}"])</script><script>self.__next_f.push([1,"6:[[\"$\",\"div\",null,{\"className\":\"main\",\"id\":\"main\",\"children\":[\"$\",\"section\",null,{\"className\":\"sightseeingDetailPage--main\",\"children\":[\"$\",\"div\",null,{\"className\":\"sightseeingDetailPage--main--container\",\"children\":[\"$L17\",[\"$\",\"$L18\",null,{\"initialData\":{\"tourInfo\":{\"tourId\":\"00000000-0000-0000-0000-000000000000\",\"tourCode\":null,\"departureId\":1,\"departureName\":\"TP. Hồ Chí Minh\",\"destination\":\"Khám phá Tây Bắc: Hòa Bình - Mộc Châu - Điện Biên - Lai Châu - Sapa - Fansipan - Yên Bái - Hà Nội | Tặng vé tàu hỏa leo núi Mường Hoa\",\"departureDate\":\"0001-01-01T00:00:00\",\"endDate\":\"0001-01-01T00:00:00\",\"durationTime\":null,\"startTime\":\"00:00:00\",\"starHotel\":null,\"description\":\"\",\"keywords\":\"\",\"promotionBooking\":null,\"tourPrice\":null,\"tourServices\":null,\"tourTypeId\":1,\"tourLineId\":0,\"customerTitle\":[{\"idTitle\":0,\"fromYear\":0,\"toYear\":0}],\"dayStay\":7,\"dayStayText\":\"7N6Đ\",\"remainPax\":0,\"utility\":{\"time\":null,\"transport\":\"Máy bay, Xe du lịch\",\"visitLocation\":\"Tây Bắc, Hòa Bình, Mộc Châu, Điện Biên, Lai Châu, Sapa, Fansipan, Yên Bái, Hà Nội \",\"cuisine\":\"Theo thực đơn\",\"hotel\":\"Khách sạn 3 sao, Khách sạn 2 sao\",\"idealTime\":\"Quanh năm\",\"suitableObject\":\"Cặp đôi, Gia đình nhiều thế hệ, Thanh niên\",\"promotion\":\"Đã bao gồm ưu đãi trong giá tour\",\"listVisitLocation\":[\"Tây Bắc\",\" Hòa Bình\",\" Mộc Châu\",\" Điện Biên\",\" Lai Châu\",\" Sapa\",\" Fansipan\",\" Yên Bái\",\" Hà Nội \"]},\"imgUrls\":[{\"imgUrl\":\"https://media.travel.com.vn/Tour/tfd__1_13057_ethnic-minority-children-playing-in-the-plum-blossom-garden-in-full-bloom.webp\",\"imgTitle\":\"Tphcm - Hà Nội - Bảo tàng Lịch sử Quân sự - Đèo Thung Khe - Mộc Châu\\t\",\"priority\":null},{\"imgUrl\":\"https://media.travel.com.vn/Tour/tfd__1_13057_mcis-2.webp\",\"imgTitle\":\"Mộc Châu - Tp. Sơn La - Điện Biên\",\"priority\":null},{\"imgUrl\":\"https://media.travel.com.vn/Tour/tfd__0_13057_3-bao-tang-chien-thang-dien-bien-phu-da-in-xuan-tu.webp\",\"imgTitle\":\"Điện Biên - Lai Châu\",\"priority\":null},{\"imgUrl\":\"https://media.travel.com.vn/Tour/tfd__2_13057_cap-treo-fansipan.webp\",\"imgTitle\":\"Lai Châu - Sapa\",\"priority\":null},{\"imgUrl\":\"https://media.travel.com.vn/Tour/tfd__1_13057_hmong-ethnic-minority-women-walking-on-rice-terraces.webp\",\"imgTitle\":\"Sapa - Mù Cang Chải - Nghĩa Lộ\",\"priority\":null},{\"imgUrl\":\"https://media.travel.com.vn/Tour/tfd__1_13057_le-hoi-den-hung.webp\",\"imgTitle\":\"Nghĩa Lộ - Yên Bái - Hà Nội\",\"priority\":null},{\"imgUrl\":\"https://media.travel.com.vn/Tour/tfd__0_13057_ho-guom-2.webp\",\"imgTitle\":\"Hà Nội - Tp. HCM\",\"priority\":null}],\"videoUrls\":[],\"breadCrumbs\":[{\"label\":\"Trong nước\",\"url\":\"viet-nam\",\"order\":0},{\"label\":\"Miền Bắc\",\"url\":\"mien-bac\",\"order\":1},{\"label\":\"Hà Nội\",\"url\":\"ha-noi\",\"order\":2},{\"label\":\"Lào Cai\",\"url\":\"lao-cai\",\"order\":3},{\"label\":\"Sơn La\",\"url\":\"son-la\",\"order\":4},{\"label\":\"Hòa Bình\",\"url\":\"hoa-binh\",\"order\":5}],\"pageId\":13057,\"pageCode\":\"NDSGN1722\",\"pageTitle\":\"Khám phá Tây Bắc| Hòa Bình - Mộc Châu - Điện Biên - Lai Châu - Sapa - Fansipan - Yên Bái - Hà Nội | Tặng vé tàu hỏa leo núi Mường Hoa\",\"tourSchedules\":[{\"id\":1,\"name\":\"Ngày 1\",\"title\":\"Tphcm - Hà Nội - Bảo tàng Lịch sử Quân sự - Đèo Thung Khe - Mộc Châu\\t\",\"mealInfor\":\"\u003cp\u003e02 bữa ăn (trưa, chiều)\u003c/p\u003e\",\"description\":\"$19\"},{\"id\":2,\"name\":\"Ngày 2\",\"title\":\"Mộc Châu - Tp. Sơn La - Điện Biên\",\"mealInfor\":\"\u003cp\u003e03 bữa ăn (sáng, trưa, chiều)\u003c/p\u003e\",\"description\":\"\u003cp class=\\\"ql-align-justify\\\"\u003eQuý khách dùng bữa sáng và làm thủ tục trả phòng sớm, xe và hướng dẫn viên khởi hành tham quan:\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cstrong\u003eChụp ảnh tại đồi chè trái tim -\u003c/strong\u003e một trong những đồi chè lớn nhất tại Mộc Châu thu hút rất nhiều sự quan tâm của các tín đồ đam mê chụp ảnh\u003cstrong\u003e.\u003c/strong\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp class=\\\"ql-align-justify\\\"\u003eTiếp tục hành trình, Quý khách khởi hành đi Điện Biên. Trên đường \u003cstrong\u003engắm Đèo Pha Đin\u003c/strong\u003e - đây cũng là một trong \u0026quot;tứ đại đèo\u0026quot; vùng Đông Tây Bắc và được xếp cùng nhóm 6 con đèo gây ấn tượng nhất Việt Nam.\u003c/p\u003e\u003cp class=\\\"ql-align-justify\\\"\u003eQuý khách nhận phòng khách sạn và dùng cơm chiều. Buổi tối, Quý khách tự do tham quan \u003cstrong\u003eTượng đài chiến thắng\u003c/strong\u003e\u003cstrong style=\\\"color: black;\\\"\u003e Điện Biên Phủ\u003c/strong\u003e\u003cspan style=\\\"color: black;\\\"\u003e \u003c/span\u003e\u003cspan style=\\\"color: rgb(34, 34, 34);\\\"\u003ekhám phá thành phố Điện Biên về đêm. \u003c/span\u003e\u003c/p\u003e\u003cp class=\\\"ql-align-right\\\"\u003e\u003cstrong\u003eNghỉ đêm Tp. Điện Biên Phủ\u003c/strong\u003e\u003c/p\u003e\"},{\"id\":3,\"name\":\"Ngày 3\",\"title\":\"Điện Biên - Lai Châu\",\"mealInfor\":\"\u003cp\u003e03 bữa ăn (sáng, trưa, chiều)\u003c/p\u003e\",\"description\":\"$1a\"},{\"id\":4,\"name\":\"Ngày 4\",\"title\":\"Lai Châu - Sapa\",\"mealInfor\":\"\u003cp\u003e03 bữa ăn (sáng, trưa, chiều)\u003c/p\u003e\",\"description\":\"$1b\"},{\"id\":5,\"name\":\"Ngày 5\",\"title\":\"Sapa - Mù Cang Chải - Nghĩa Lộ\",\"mealInfor\":\"\u003cp\u003e03 bữa ăn (sáng, trưa, chiều)\u003c/p\u003e\",\"description\":\"$1c\"},{\"id\":6,\"name\":\"Ngày 6\",\"title\":\"Nghĩa Lộ - Yên Bái - Hà Nội\",\"mealInfor\":\"\u003cp\u003e03 bữa ăn (sáng, trưa, chiều)\u003c/p\u003e\",\"description\":\"\u003cp class=\\\"ql-align-justify\\\"\u003eQuý khách dùng bữa sáng, trả phòng khách sạn và khởi hành tham quan: \u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cstrong\u003eĐền Hùng\u003c/strong\u003e:\u003cstrong\u003e \u003c/strong\u003enơi thờ các vua Hùng có công dựng nước, tổ tiên của dân tộc Việt Nam, một quần thể kiến trúc thâm nghiêm trên núi Nghĩa Lĩnh. Quý khách dâng hương đất tổ, thăm quan \u003cstrong\u003eđền Thượng, đền Trung, đền Hạ, Giếng Ngọc, Lăng vua Hùng\u003c/strong\u003e.\u003c/li\u003e\u003c/ul\u003e\u003cp class=\\\"ql-align-right\\\"\u003e\u003cstrong\u003eNghỉ đêm tại Hà Nội\u003c/strong\u003e \u003c/p\u003e\"},{\"id\":7,\"name\":\"Ngày 7\",\"title\":\"Hà Nội - Tp. HCM\",\"mealInfor\":\"\u003cp\u003e01 bữa ăn (Ăn sáng hộp mang đi)\u003c/p\u003e\",\"description\":\"$1d\"}],\"tourNotes\":{\"priceIncluded\":\"-\\tXe tham quan (15, 25,35 chỗ tùy theo số lượng khách) theo chương trình\u003cbr/\u003e-\\tVé máy bay khứ hồi \u003cbr/\u003e-\\tKhách sạn 2\u00263 sao theo tiêu chuẩn 2 khách/phòng hoặc 3 khách/phòng. \u003cbr/\u003e-\\tCác bữa ăn chính theo chương trình \u003cbr/\u003e-\\tVé tham quan theo chương trình   \u003cbr/\u003e-\\tHướng dẫn viên tiếng Việt nối tuyến\u003cbr/\u003e-\\tBảo hiểm du lịch với mức bồi thường cao nhất 120.000.000đ/vụ\u003cbr/\u003e-\\tNón Vietravel + Nước suối + Khăn lạnh \u003cbr/\u003e-\\tThuế VAT \u003cbr/\u003e\",\"priceNotIncluded\":\"-\\tChi phí cá nhân: ăn uống ngoài chương trình, giặt ủi, chi phí hủy đổi hành trình và nâng hạng chuyến bay, hành lý quá cước, phụ thu phòng đơn,…\u003cbr/\u003e-\\tChi phí tham quan ngoài chương trình\u003cbr/\u003e-\\tVé tham quan cầu kính tại Thác Dải Yếm, Cáp treo Fansipan, Cầu Kính Rồng Mây, Cầu Kính Bạch Long\u003cbr/\u003e\",\"noteChildrenPrice\":\"-\\tTrẻ em dưới 5 tuổi:  không thu phí dịch vụ, bố mẹ tự lo cho bé và thanh toán các chi phí phát sinh (đối với các dịch vụ tính phí theo chiều cao…). Hai người lớn chỉ được kèm 1 trẻ em dưới 5 tuổi, trẻ em thứ 2 sẽ đóng phí theo qui định dành cho độ tuổi từ 5 đến dưới 12 tuổi và phụ thu phòng đơn. Vé máy bay, tàu hỏa, phương tiện vận chuyển công cộng mua vé theo qui định của các đơn vị vận chuyển.\u003cbr/\u003e-\\tTrẻ em từ 5 tuổi đến dưới 12 tuổi: 75% giá tour người lớn (không có chế độ giường riêng). Hai người lớn chỉ được kèm 1 trẻ em từ 5 - dưới 12 tuổi, em thứ hai trở lên phải mua 1 suất giường đơn.\u003cbr/\u003e-\\tTrẻ em từ 12 tuổi trở lên: mua một vé như người lớn\u003cbr/\u003e\",\"paymentConditions\":\"-\\tKhi đăng ký đặt cọc 50% số tiền tour\u003cbr/\u003e-\\tSố tiền còn lại thanh toán hết trước ngày khởi hành 7-10 ngày (áp dụng tour ngày thường), trước ngày khởi hành 20-25 ngày (áp dụng tour lễ tết) \u003cbr/\u003e\",\"registrationConditions\":\"$1e\",\"noteTransferCancel\":\"Sau khi đóng tiền, nếu Quý khách muốn chuyển/huỷ tour xin vui lòng mang Vé Du Lịch đến văn phòng  đăng ký tour để làm thủ tục chuyển/huỷ tour và chịu mất phí theo quy định của Vietravel. Không giải quyết các trường hợp liên hệ chuyển/huỷ tour qua điện thoại.\",\"transferCancelConditions\":\"- \\tĐược chuyển sang các tuyến du lịch khác trước ngày khởi hành 20 ngày: Không mất chi phí.\u003cbr/\u003e- \\tNếu hủy hoặc chuyển sang các chuyến du lịch khác ngay sau khi đăng ký từ 15-19 ngày trước ngày khởi hành: Chi phí hủy tour: 50% tiền cọc tour.\u003cbr/\u003e- \\tNếu hủy hoặc chuyển sang các chuyến du lịch khác từ 12-14 ngày trước ngày khởi hành: Chi phí hủy tour: 100% tiền cọc tour.\u003cbr/\u003e- \\tNếu hủy chuyến du lịch trong vòng từ 08-11 ngày trước ngày khởi hành: Chi phí hủy tour: 50% trên giá tour du lịch.\u003cbr/\u003e- \\tNếu hủy chuyến du lịch trong vòng từ 05-07 ngày trước ngày khởi hành: Chi phí hủy tour: 70% trên giá tour du lịch.\u003cbr/\u003e- \\tNếu hủy chuyến du lịch trong vòng từ 02-04 ngày trước ngày khởi hành: Chi phí hủy tour: 90% trên giá vé du lịch.\u003cbr/\u003e- \\tNếu hủy chuyến du lịch trong vòng 1 ngày trước ngày khởi hành : Chi phí hủy tour: 100% trên giá vé du lịch.\u003cbr/\u003e\",\"holidayCancelConditions\":\"- \\tĐược chuyển sang các tuyến du lịch khác trước ngày khởi hành 30 ngày: Không mất chi phí.\u003cbr/\u003e- \\tNếu hủy hoặc chuyển sang các chuyến du lịch khác ngay sau khi đăng ký từ 25-29 ngày trước ngày khởi hành: Chi phí hủy tour: 50% tiền cọc tour.\u003cbr/\u003e-\\tNếu hủy hoặc chuyển sang các chuyến du lịch khác từ 20-24 ngày trước ngày khởi hành: Chi phí hủy tour: 100% tiền cọc tour.\u003cbr/\u003e- \\tNếu hủy chuyến du lịch trong vòng từ 17-19 ngày trước ngày khởi hành: Chi phí hủy tour: 50% trên giá tour du lịch.\u003cbr/\u003e- \\tNếu hủy chuyến du lịch trong vòng từ 08-16 ngày trước ngày khởi hành: Chi phí hủy tour: 70% trên giá tour du lịch.\u003cbr/\u003e- \\tNếu hủy chuyến du lịch trong vòng từ 02-07 ngày trước ngày khởi hành: Chi phí hủy tour: 90% trên giá vé du lịch.\u003cbr/\u003e- \\tNếu hủy chuyến du lịch trong vòng 1 ngày trước ngày khởi hành : Chi phí hủy tour: 100% trên giá vé du lịch.\u003cbr/\u003e\",\"caseOfForceMajeure\":\"- Nếu chương trình du lịch bị hủy bỏ hoặc thay đổi bởi một trong hai bên vì lý do bất khả kháng (hỏa hoạn, thời tiết, tai nạn, thiên tai, chiến tranh, dịch bệnh, hoãn, dời, và hủy chuyến hoặc thay đổi khác của các phương tiện vận chuyển công cộng hoặc các sự kiến bất khả kháng khác theo quy định pháp luật…), thì hai bên sẽ không chịu bất kỳ nghĩa vụ bồi hoàn các tổn thất đã xảy ra và không chịu bất kỳ trách nhiệm pháp lý nào. Tuy nhiên mỗi bên có trách nhiệm cố gắng tối đa để giúp đỡ bên bị thiệt hại nhằm giảm thiểu các tổn thất gây ra vì lý do bất khả kháng.\",\"contact\":\"\u003cp class=\\\"ql-align-center\\\"\u003e\u003cstrong style=\\\"color: black;\\\"\u003eMọi chi tiết vui lòng liên hệ\u003c/strong\u003e\u003c/p\u003e\u003cp class=\\\"ql-align-center\\\"\u003e\u003cstrong style=\\\"color: black;\\\"\u003eKHỐI KHÁCH LẺ - DU LỊCH TRONG NƯỚC\u003c/strong\u003e\u003c/p\u003e\u003cp class=\\\"ql-align-center\\\"\u003e\u003cspan style=\\\"color: black;\\\"\u003e190 PASTEUR, PHƯỜNG VÕ THỊ SÁU, QUẬN 3, TP.HCM\u003c/span\u003e\u003c/p\u003e\u003cp class=\\\"ql-align-center\\\"\u003e\u003cspan style=\\\"color: black;\\\"\u003eĐiện thoại: 028 3822 8898\u003c/span\u003e\u003c/p\u003e\u003cp class=\\\"ql-align-center\\\"\u003e\u003cspan style=\\\"color: black;\\\"\u003eHotline: 1900.1839\u003c/span\u003e\u003c/p\u003e\u003cp class=\\\"ql-align-center\\\"\u003e\u003cstrong style=\\\"color: black;\\\"\u003eVIETRAVEL KÍNH CHÚC QUÝ KHÁCH MỘT CHUYẾN DU LỊCH VUI VẺ!\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\",\"visaInfo\":\"\",\"reasonChoose\":null},\"minPrice\":10690000,\"rating\":0,\"ratingText\":\"Kém\",\"rateCount\":0,\"destinationInfo\":{\"name\":\"Hà Nội\",\"latitude\":\"21.027764\",\"longitude\":\"105.83416\"}}},\"queryKey\":[\"tour-details_info\",{\"pageId\":\"13057\"}]}]]}]}]}],[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"$1f\"}}]]\n"])</script><script>self.__next_f.push([1,"20:T2322,"])</script><script>self.__next_f.push([1," Ngày 1: Quý khách tập trung tại sân bay Tân Sơn Nhất (ga trong nước), hướng dẫn viên làm thủ tục cho Quý khách đáp chuyến bay đi Hà Nội. Đến sân bay Nội Bài, xe đón đoàn khởi hành đi Mộc Châu (Sơn La) trên đường dừng tham quan:Bảo tàng lịch sử quân sự - khám phá không gian trưng bày ấn tượng với các hiện vật quân sự độc đáo, máy bay, xe tăng, và Tháp Cờ Hà Nội - biểu tượng thiêng liêng giữa lòng thủ đô. Nơi đây mang đến cái nhìn tổng quan về chặng đường phát triển của quân đội Việt Nam qua từng thời kỳ.Chụp hình đèo Thung Khe hay còn gọi là đèo Đá Trắng, nơi đây quanh năm trắng như tuyết và mây mù bao phủ tạo cảnh quan tuyệt đep thu hút nhiều du khách đến chụp ảnh.Quần thể phức hợp vui chơi giải trí và nghỉ dưỡng Mộc Châu Island chiêm ngưỡng vẻ đẹp Cầu kính Bạch Long có chiều dài 632m, ở độ cao cách mặt đất 150m, là “Cây cầu kính đi bộ dài nhất thế giới” được xác lập kỷ lục Guinness vào tháng 28/5/2022. Trải nghiệm các trò chơi: Chinh phục cầu kính Bạch Long, trượt Airslide, zipline, Mộc Châu Space,… (chi phí tự túc).Quý khách nhận phòng khách sạn nghỉ ngơi. Buổi tối, Quý khách có thể tự do tham quan khu phố Nhật Bản - với nhiều khu vực khác nhau mang đậm phong cách Nhật Bản như: khu quảng trường; Sakura Café, trà đạo phong cách Nhật,… tham gia các hoạt động cuối tuần tại Phố đi bộ Mộc Châu hoặc tận hưởng không khí thanh bình vùng cao nguyên với tách trà nóng đậm đà.Nghỉ đêm tại Mộc Châu Ngày 2: Quý khách dùng bữa sáng và làm thủ tục trả phòng sớm, xe và hướng dẫn viên khởi hành tham quan:Chụp ảnh tại đồi chè trái tim - một trong những đồi chè lớn nhất tại Mộc Châu thu hút rất nhiều sự quan tâm của các tín đồ đam mê chụp ảnh.Tiếp tục hành trình, Quý khách khởi hành đi Điện Biên. Trên đường ngắm Đèo Pha Đin - đây cũng là một trong \"tứ đại đèo\" vùng Đông Tây Bắc và được xếp cùng nhóm 6 con đèo gây ấn tượng nhất Việt Nam.Quý khách nhận phòng khách sạn và dùng cơm chiều. Buổi tối, Quý khách tự do tham quan Tượng đài chiến thắng Điện Biên Phủ khám phá thành phố Điện Biên về đêm. Nghỉ đêm Tp. Điện Biên Phủ Ngày 3: Sau khi ăn sáng và làm thủ tục trả phòng, Quý khách tham quan: Bảo tàng Chiến thắng lịch sử Điện Biên Phủ: trưng bày hơn 1.000 tư liệu hình ảnh, tài liệu, hiện vật, cảnh tượng lịch sử tái hiện lại cuộc chiến hào hùng của quân và dân ta trong Chiến dịch Điện Biên Phủ năm 1954.Chiêm ngưỡng kiệt tác bức tranh Panorama toàn cảnh “Trận chiến Điện Biên Phủ” sống động: Tái hiện chân thực những khoảnh khắc điển hình nhất trong Chiến dịch Điện Biên Phủ.Ngắm cầu Mường Thanh, sông Nậm Rốm và con đường hoa ban trong trung tâm thành phố.Tham quan và mua sắm đặc sản Quà Tây Bắc Điện Biên về làm quà cho người thân và gia đình như gạo Điện Biên, mật ong, sâu chít, thịt trâu hun khói, chẳm chéo, măng, các sản phẩm mây tre đan, các sản phẩm thêu, dệt thổ cẩm,..Quý khách khởi hành đi Lai Châu, trên đường ngắm cảnh rừng núi Tây Bắc dọc theo dòng sông Nậm Na và vùng ngập nước do đập nhà máy Thủy điện Sơn La dâng lên tại ngã ba sông: sông Đà, sông Nậm Na và sông Nậm Rốm.Quý khách dùng cơm chiều và nhận phòng khách sạn nghỉ ngơi. Buổi tối, quý khách tự do khám phá, thưởng trà và ngắm toàn cảnh thành phố Lai Châu về đêm tại Tam Đường Tea (chi phí tự túc).Nghỉ đêm tại Lai Châu Ngày 4: Quý khách dùng điểm tâm sáng và làm thủ tục trả phòng. Xe đưa Quý khách chinh phục đèo Ô Quy Hồ - con đèo đẹp, hùng vĩ và dài nhất trong Tứ Đại Đỉnh Đèo miền Bắc.Đến với thanh phố trong sương Sapa, Quý khách tham quan khu du lịch Fansipan Legend thưởng ngoạn bức tranh phong cảnh đầy màu sắc của cánh rừng nguyên sinh, thung lũng Mường Hoa.Chinh phục đỉnh núi Fansipan với độ cao 3.143m hùng vĩ bằng cáp treo (chi phí tự túc).Lễ Phật tại chùa Trình hay cầu phúc lộc, bình an cho gia đình tại Bích Vân Thiền Tự trong hệ thống cảnh quan tâm linh trên đỉnh Fansipan.Trải nghiệm tuyến tàu lửa Mường Hoa hiện đại nhất Việt Nam.Bản Cát Cát - Thăm những nếp nhà của người Mông, Dao, Giáy trong bản, tại đây du khách sẽ không khỏi ngỡ ngàng trước vẻ đẹp của một trong những ngôi làng cổ đẹp nhất Sapa và có dịp được thưởng thức chương trình biểu diễn văn nghệ của người H'Mông (chương trình văn nghệ diễn ra vào các thời điểm cố định trong ngày). Quý khách dùng cơm chiều và nhận phòng khách sạn nghỉ ngơi.Buổi tối Quý khách tự do dạo phố, ngắm nhà thờ Đá Sapa và thưởng thức đặc sản vùng cao tại Chợ đêm Sapa như: thịt lợn cắp nách nướng, trứng nướng, rượu táo mèo,… giao lưu với người dân tộc vùng cao.Nghỉ đêm tại SapaLưu ý: Trong trường hợp, Fansipan không hoạt động chương trình sẽ được thay thế bằng điểm tham quan Cầu Kính Rồng Mây (không bao gồm vé tham quan).Chương trình tặng vé trải nghiệm tàu hỏa leo núi Mường Hoa sẽ không được hoàn lại chi phí và không thay thế dịch vụ khác trong trường hợp Quý khách không tham gia hoặc phải hủy do điều kiện khách quan về thời tiết, cung đường, thông báo từ đơn vị cung ứng. Ngày 5: Trả phòng khách sạn, đoàn khởi hành tham quan Mù Cang Chải, ngang qua:Ngắm Bản Lìm Mông từ trên cao: đây là Bản của dân tộc Mông và là nơi có ruộng lúa đẹp nhất Mù Cang Chải. Quý khách sẽ bị mê hoặc bởi vẻ đẹp hút hồn của cung đường ruộng bậc thang nổi tiếng tại 3 xã: La Pán Tẩn, Chế Cu Nha và Zế Xu Phình. Quý khách chiêm ngưỡng những thung lũng rộng hút tầm mắt, các thửa ruộng tầng tầng lớp lớp lượn sóng theo sườn núi, ngọn núi này nối tiếp ngọn núi khác.Đèo Khau Phạ: đoạn đèo dài nhất trên tuyến quốc lộ 32 được mệnh danh là một trong “tứ đại đỉnh đèo” với độ dài trên 30km.Tú Lệ: quý khách sẽ ngửi được mùi hương thoang thoảng theo gió bảng lảng trên mái nhà của “cơm mới”, nơi đây nổi tiếng với xôi nếp, cốm khô.Buổi tối, Quý khách dùng cơm chiều và thưởng thức chương trình biểu diễn múa Xòe, giao lưu và tìm hiểu nét văn hóa đặc sắc của dân tộc Thái (chương trình biểu diễn dành tặng cho đoàn từ 20 khách trở lên). Nghỉ đêm tại Nghĩa Lộ Ngày 6: Quý khách dùng bữa sáng, trả phòng khách sạn và khởi hành tham quan: Đền Hùng: nơi thờ các vua Hùng có công dựng nước, tổ tiên của dân tộc Việt Nam, một quần thể kiến trúc thâm nghiêm trên núi Nghĩa Lĩnh. Quý khách dâng hương đất tổ, thăm quan đền Thượng, đền Trung, đền Hạ, Giếng Ngọc, Lăng vua Hùng.Nghỉ đêm tại Hà Nội Ngày 7: Quý khách ăn sáng và trả phòng. Tiếp tục hành trình đến sân bay Nội Bài, Hướng dẫn viên hỗ trợ Quý khách làm thủ tục đáp chuyến bay về Tp.HCM. Chia tay Quý khách và kết thúc chương trình du lịch tại sân bay Tân Sơn Nhất. KẾT THÚC CHƯƠNG TRÌNH, CẢM ƠN VÀ TẠM BIỆT QUÝ KHÁCH!*Lưu ý:Hành trình có thể thay đổi thứ tự điểm đến tùy vào điều kiện thực tế. Lịch trình tham quan (tắm biển, ngắm hoa, trải nghiệm,...) rất dễ bị ảnh hưởng bởi thời tiết. Đây là trường hợp bất khả kháng mong Quý khách hiểu và thông cảm.Khách Sạn có thể ở xa trung tâm thành phố vào các mùa Cao Điểm. Cơ cấu phòng sẽ phụ thuộc vào tình hình thực tế của khách sạn khi làm thủ tục nhận phòng. Vietravel hỗ trợ 1 bữa ăn nhẹ tại sân bay đối với các chuyến bay về sau 20:00 tối."])</script><script>self.__next_f.push([1,"21:T2322,"])</script><script>self.__next_f.push([1," Ngày 1: Quý khách tập trung tại sân bay Tân Sơn Nhất (ga trong nước), hướng dẫn viên làm thủ tục cho Quý khách đáp chuyến bay đi Hà Nội. Đến sân bay Nội Bài, xe đón đoàn khởi hành đi Mộc Châu (Sơn La) trên đường dừng tham quan:Bảo tàng lịch sử quân sự - khám phá không gian trưng bày ấn tượng với các hiện vật quân sự độc đáo, máy bay, xe tăng, và Tháp Cờ Hà Nội - biểu tượng thiêng liêng giữa lòng thủ đô. Nơi đây mang đến cái nhìn tổng quan về chặng đường phát triển của quân đội Việt Nam qua từng thời kỳ.Chụp hình đèo Thung Khe hay còn gọi là đèo Đá Trắng, nơi đây quanh năm trắng như tuyết và mây mù bao phủ tạo cảnh quan tuyệt đep thu hút nhiều du khách đến chụp ảnh.Quần thể phức hợp vui chơi giải trí và nghỉ dưỡng Mộc Châu Island chiêm ngưỡng vẻ đẹp Cầu kính Bạch Long có chiều dài 632m, ở độ cao cách mặt đất 150m, là “Cây cầu kính đi bộ dài nhất thế giới” được xác lập kỷ lục Guinness vào tháng 28/5/2022. Trải nghiệm các trò chơi: Chinh phục cầu kính Bạch Long, trượt Airslide, zipline, Mộc Châu Space,… (chi phí tự túc).Quý khách nhận phòng khách sạn nghỉ ngơi. Buổi tối, Quý khách có thể tự do tham quan khu phố Nhật Bản - với nhiều khu vực khác nhau mang đậm phong cách Nhật Bản như: khu quảng trường; Sakura Café, trà đạo phong cách Nhật,… tham gia các hoạt động cuối tuần tại Phố đi bộ Mộc Châu hoặc tận hưởng không khí thanh bình vùng cao nguyên với tách trà nóng đậm đà.Nghỉ đêm tại Mộc Châu Ngày 2: Quý khách dùng bữa sáng và làm thủ tục trả phòng sớm, xe và hướng dẫn viên khởi hành tham quan:Chụp ảnh tại đồi chè trái tim - một trong những đồi chè lớn nhất tại Mộc Châu thu hút rất nhiều sự quan tâm của các tín đồ đam mê chụp ảnh.Tiếp tục hành trình, Quý khách khởi hành đi Điện Biên. Trên đường ngắm Đèo Pha Đin - đây cũng là một trong \"tứ đại đèo\" vùng Đông Tây Bắc và được xếp cùng nhóm 6 con đèo gây ấn tượng nhất Việt Nam.Quý khách nhận phòng khách sạn và dùng cơm chiều. Buổi tối, Quý khách tự do tham quan Tượng đài chiến thắng Điện Biên Phủ khám phá thành phố Điện Biên về đêm. Nghỉ đêm Tp. Điện Biên Phủ Ngày 3: Sau khi ăn sáng và làm thủ tục trả phòng, Quý khách tham quan: Bảo tàng Chiến thắng lịch sử Điện Biên Phủ: trưng bày hơn 1.000 tư liệu hình ảnh, tài liệu, hiện vật, cảnh tượng lịch sử tái hiện lại cuộc chiến hào hùng của quân và dân ta trong Chiến dịch Điện Biên Phủ năm 1954.Chiêm ngưỡng kiệt tác bức tranh Panorama toàn cảnh “Trận chiến Điện Biên Phủ” sống động: Tái hiện chân thực những khoảnh khắc điển hình nhất trong Chiến dịch Điện Biên Phủ.Ngắm cầu Mường Thanh, sông Nậm Rốm và con đường hoa ban trong trung tâm thành phố.Tham quan và mua sắm đặc sản Quà Tây Bắc Điện Biên về làm quà cho người thân và gia đình như gạo Điện Biên, mật ong, sâu chít, thịt trâu hun khói, chẳm chéo, măng, các sản phẩm mây tre đan, các sản phẩm thêu, dệt thổ cẩm,..Quý khách khởi hành đi Lai Châu, trên đường ngắm cảnh rừng núi Tây Bắc dọc theo dòng sông Nậm Na và vùng ngập nước do đập nhà máy Thủy điện Sơn La dâng lên tại ngã ba sông: sông Đà, sông Nậm Na và sông Nậm Rốm.Quý khách dùng cơm chiều và nhận phòng khách sạn nghỉ ngơi. Buổi tối, quý khách tự do khám phá, thưởng trà và ngắm toàn cảnh thành phố Lai Châu về đêm tại Tam Đường Tea (chi phí tự túc).Nghỉ đêm tại Lai Châu Ngày 4: Quý khách dùng điểm tâm sáng và làm thủ tục trả phòng. Xe đưa Quý khách chinh phục đèo Ô Quy Hồ - con đèo đẹp, hùng vĩ và dài nhất trong Tứ Đại Đỉnh Đèo miền Bắc.Đến với thanh phố trong sương Sapa, Quý khách tham quan khu du lịch Fansipan Legend thưởng ngoạn bức tranh phong cảnh đầy màu sắc của cánh rừng nguyên sinh, thung lũng Mường Hoa.Chinh phục đỉnh núi Fansipan với độ cao 3.143m hùng vĩ bằng cáp treo (chi phí tự túc).Lễ Phật tại chùa Trình hay cầu phúc lộc, bình an cho gia đình tại Bích Vân Thiền Tự trong hệ thống cảnh quan tâm linh trên đỉnh Fansipan.Trải nghiệm tuyến tàu lửa Mường Hoa hiện đại nhất Việt Nam.Bản Cát Cát - Thăm những nếp nhà của người Mông, Dao, Giáy trong bản, tại đây du khách sẽ không khỏi ngỡ ngàng trước vẻ đẹp của một trong những ngôi làng cổ đẹp nhất Sapa và có dịp được thưởng thức chương trình biểu diễn văn nghệ của người H'Mông (chương trình văn nghệ diễn ra vào các thời điểm cố định trong ngày). Quý khách dùng cơm chiều và nhận phòng khách sạn nghỉ ngơi.Buổi tối Quý khách tự do dạo phố, ngắm nhà thờ Đá Sapa và thưởng thức đặc sản vùng cao tại Chợ đêm Sapa như: thịt lợn cắp nách nướng, trứng nướng, rượu táo mèo,… giao lưu với người dân tộc vùng cao.Nghỉ đêm tại SapaLưu ý: Trong trường hợp, Fansipan không hoạt động chương trình sẽ được thay thế bằng điểm tham quan Cầu Kính Rồng Mây (không bao gồm vé tham quan).Chương trình tặng vé trải nghiệm tàu hỏa leo núi Mường Hoa sẽ không được hoàn lại chi phí và không thay thế dịch vụ khác trong trường hợp Quý khách không tham gia hoặc phải hủy do điều kiện khách quan về thời tiết, cung đường, thông báo từ đơn vị cung ứng. Ngày 5: Trả phòng khách sạn, đoàn khởi hành tham quan Mù Cang Chải, ngang qua:Ngắm Bản Lìm Mông từ trên cao: đây là Bản của dân tộc Mông và là nơi có ruộng lúa đẹp nhất Mù Cang Chải. Quý khách sẽ bị mê hoặc bởi vẻ đẹp hút hồn của cung đường ruộng bậc thang nổi tiếng tại 3 xã: La Pán Tẩn, Chế Cu Nha và Zế Xu Phình. Quý khách chiêm ngưỡng những thung lũng rộng hút tầm mắt, các thửa ruộng tầng tầng lớp lớp lượn sóng theo sườn núi, ngọn núi này nối tiếp ngọn núi khác.Đèo Khau Phạ: đoạn đèo dài nhất trên tuyến quốc lộ 32 được mệnh danh là một trong “tứ đại đỉnh đèo” với độ dài trên 30km.Tú Lệ: quý khách sẽ ngửi được mùi hương thoang thoảng theo gió bảng lảng trên mái nhà của “cơm mới”, nơi đây nổi tiếng với xôi nếp, cốm khô.Buổi tối, Quý khách dùng cơm chiều và thưởng thức chương trình biểu diễn múa Xòe, giao lưu và tìm hiểu nét văn hóa đặc sắc của dân tộc Thái (chương trình biểu diễn dành tặng cho đoàn từ 20 khách trở lên). Nghỉ đêm tại Nghĩa Lộ Ngày 6: Quý khách dùng bữa sáng, trả phòng khách sạn và khởi hành tham quan: Đền Hùng: nơi thờ các vua Hùng có công dựng nước, tổ tiên của dân tộc Việt Nam, một quần thể kiến trúc thâm nghiêm trên núi Nghĩa Lĩnh. Quý khách dâng hương đất tổ, thăm quan đền Thượng, đền Trung, đền Hạ, Giếng Ngọc, Lăng vua Hùng.Nghỉ đêm tại Hà Nội Ngày 7: Quý khách ăn sáng và trả phòng. Tiếp tục hành trình đến sân bay Nội Bài, Hướng dẫn viên hỗ trợ Quý khách làm thủ tục đáp chuyến bay về Tp.HCM. Chia tay Quý khách và kết thúc chương trình du lịch tại sân bay Tân Sơn Nhất. KẾT THÚC CHƯƠNG TRÌNH, CẢM ƠN VÀ TẠM BIỆT QUÝ KHÁCH!*Lưu ý:Hành trình có thể thay đổi thứ tự điểm đến tùy vào điều kiện thực tế. Lịch trình tham quan (tắm biển, ngắm hoa, trải nghiệm,...) rất dễ bị ảnh hưởng bởi thời tiết. Đây là trường hợp bất khả kháng mong Quý khách hiểu và thông cảm.Khách Sạn có thể ở xa trung tâm thành phố vào các mùa Cao Điểm. Cơ cấu phòng sẽ phụ thuộc vào tình hình thực tế của khách sạn khi làm thủ tục nhận phòng. Vietravel hỗ trợ 1 bữa ăn nhẹ tại sân bay đối với các chuyến bay về sau 20:00 tối."])</script><script>self.__next_f.push([1,"22:T2322,"])</script><script>self.__next_f.push([1," Ngày 1: Quý khách tập trung tại sân bay Tân Sơn Nhất (ga trong nước), hướng dẫn viên làm thủ tục cho Quý khách đáp chuyến bay đi Hà Nội. Đến sân bay Nội Bài, xe đón đoàn khởi hành đi Mộc Châu (Sơn La) trên đường dừng tham quan:Bảo tàng lịch sử quân sự - khám phá không gian trưng bày ấn tượng với các hiện vật quân sự độc đáo, máy bay, xe tăng, và Tháp Cờ Hà Nội - biểu tượng thiêng liêng giữa lòng thủ đô. Nơi đây mang đến cái nhìn tổng quan về chặng đường phát triển của quân đội Việt Nam qua từng thời kỳ.Chụp hình đèo Thung Khe hay còn gọi là đèo Đá Trắng, nơi đây quanh năm trắng như tuyết và mây mù bao phủ tạo cảnh quan tuyệt đep thu hút nhiều du khách đến chụp ảnh.Quần thể phức hợp vui chơi giải trí và nghỉ dưỡng Mộc Châu Island chiêm ngưỡng vẻ đẹp Cầu kính Bạch Long có chiều dài 632m, ở độ cao cách mặt đất 150m, là “Cây cầu kính đi bộ dài nhất thế giới” được xác lập kỷ lục Guinness vào tháng 28/5/2022. Trải nghiệm các trò chơi: Chinh phục cầu kính Bạch Long, trượt Airslide, zipline, Mộc Châu Space,… (chi phí tự túc).Quý khách nhận phòng khách sạn nghỉ ngơi. Buổi tối, Quý khách có thể tự do tham quan khu phố Nhật Bản - với nhiều khu vực khác nhau mang đậm phong cách Nhật Bản như: khu quảng trường; Sakura Café, trà đạo phong cách Nhật,… tham gia các hoạt động cuối tuần tại Phố đi bộ Mộc Châu hoặc tận hưởng không khí thanh bình vùng cao nguyên với tách trà nóng đậm đà.Nghỉ đêm tại Mộc Châu Ngày 2: Quý khách dùng bữa sáng và làm thủ tục trả phòng sớm, xe và hướng dẫn viên khởi hành tham quan:Chụp ảnh tại đồi chè trái tim - một trong những đồi chè lớn nhất tại Mộc Châu thu hút rất nhiều sự quan tâm của các tín đồ đam mê chụp ảnh.Tiếp tục hành trình, Quý khách khởi hành đi Điện Biên. Trên đường ngắm Đèo Pha Đin - đây cũng là một trong \"tứ đại đèo\" vùng Đông Tây Bắc và được xếp cùng nhóm 6 con đèo gây ấn tượng nhất Việt Nam.Quý khách nhận phòng khách sạn và dùng cơm chiều. Buổi tối, Quý khách tự do tham quan Tượng đài chiến thắng Điện Biên Phủ khám phá thành phố Điện Biên về đêm. Nghỉ đêm Tp. Điện Biên Phủ Ngày 3: Sau khi ăn sáng và làm thủ tục trả phòng, Quý khách tham quan: Bảo tàng Chiến thắng lịch sử Điện Biên Phủ: trưng bày hơn 1.000 tư liệu hình ảnh, tài liệu, hiện vật, cảnh tượng lịch sử tái hiện lại cuộc chiến hào hùng của quân và dân ta trong Chiến dịch Điện Biên Phủ năm 1954.Chiêm ngưỡng kiệt tác bức tranh Panorama toàn cảnh “Trận chiến Điện Biên Phủ” sống động: Tái hiện chân thực những khoảnh khắc điển hình nhất trong Chiến dịch Điện Biên Phủ.Ngắm cầu Mường Thanh, sông Nậm Rốm và con đường hoa ban trong trung tâm thành phố.Tham quan và mua sắm đặc sản Quà Tây Bắc Điện Biên về làm quà cho người thân và gia đình như gạo Điện Biên, mật ong, sâu chít, thịt trâu hun khói, chẳm chéo, măng, các sản phẩm mây tre đan, các sản phẩm thêu, dệt thổ cẩm,..Quý khách khởi hành đi Lai Châu, trên đường ngắm cảnh rừng núi Tây Bắc dọc theo dòng sông Nậm Na và vùng ngập nước do đập nhà máy Thủy điện Sơn La dâng lên tại ngã ba sông: sông Đà, sông Nậm Na và sông Nậm Rốm.Quý khách dùng cơm chiều và nhận phòng khách sạn nghỉ ngơi. Buổi tối, quý khách tự do khám phá, thưởng trà và ngắm toàn cảnh thành phố Lai Châu về đêm tại Tam Đường Tea (chi phí tự túc).Nghỉ đêm tại Lai Châu Ngày 4: Quý khách dùng điểm tâm sáng và làm thủ tục trả phòng. Xe đưa Quý khách chinh phục đèo Ô Quy Hồ - con đèo đẹp, hùng vĩ và dài nhất trong Tứ Đại Đỉnh Đèo miền Bắc.Đến với thanh phố trong sương Sapa, Quý khách tham quan khu du lịch Fansipan Legend thưởng ngoạn bức tranh phong cảnh đầy màu sắc của cánh rừng nguyên sinh, thung lũng Mường Hoa.Chinh phục đỉnh núi Fansipan với độ cao 3.143m hùng vĩ bằng cáp treo (chi phí tự túc).Lễ Phật tại chùa Trình hay cầu phúc lộc, bình an cho gia đình tại Bích Vân Thiền Tự trong hệ thống cảnh quan tâm linh trên đỉnh Fansipan.Trải nghiệm tuyến tàu lửa Mường Hoa hiện đại nhất Việt Nam.Bản Cát Cát - Thăm những nếp nhà của người Mông, Dao, Giáy trong bản, tại đây du khách sẽ không khỏi ngỡ ngàng trước vẻ đẹp của một trong những ngôi làng cổ đẹp nhất Sapa và có dịp được thưởng thức chương trình biểu diễn văn nghệ của người H'Mông (chương trình văn nghệ diễn ra vào các thời điểm cố định trong ngày). Quý khách dùng cơm chiều và nhận phòng khách sạn nghỉ ngơi.Buổi tối Quý khách tự do dạo phố, ngắm nhà thờ Đá Sapa và thưởng thức đặc sản vùng cao tại Chợ đêm Sapa như: thịt lợn cắp nách nướng, trứng nướng, rượu táo mèo,… giao lưu với người dân tộc vùng cao.Nghỉ đêm tại SapaLưu ý: Trong trường hợp, Fansipan không hoạt động chương trình sẽ được thay thế bằng điểm tham quan Cầu Kính Rồng Mây (không bao gồm vé tham quan).Chương trình tặng vé trải nghiệm tàu hỏa leo núi Mường Hoa sẽ không được hoàn lại chi phí và không thay thế dịch vụ khác trong trường hợp Quý khách không tham gia hoặc phải hủy do điều kiện khách quan về thời tiết, cung đường, thông báo từ đơn vị cung ứng. Ngày 5: Trả phòng khách sạn, đoàn khởi hành tham quan Mù Cang Chải, ngang qua:Ngắm Bản Lìm Mông từ trên cao: đây là Bản của dân tộc Mông và là nơi có ruộng lúa đẹp nhất Mù Cang Chải. Quý khách sẽ bị mê hoặc bởi vẻ đẹp hút hồn của cung đường ruộng bậc thang nổi tiếng tại 3 xã: La Pán Tẩn, Chế Cu Nha và Zế Xu Phình. Quý khách chiêm ngưỡng những thung lũng rộng hút tầm mắt, các thửa ruộng tầng tầng lớp lớp lượn sóng theo sườn núi, ngọn núi này nối tiếp ngọn núi khác.Đèo Khau Phạ: đoạn đèo dài nhất trên tuyến quốc lộ 32 được mệnh danh là một trong “tứ đại đỉnh đèo” với độ dài trên 30km.Tú Lệ: quý khách sẽ ngửi được mùi hương thoang thoảng theo gió bảng lảng trên mái nhà của “cơm mới”, nơi đây nổi tiếng với xôi nếp, cốm khô.Buổi tối, Quý khách dùng cơm chiều và thưởng thức chương trình biểu diễn múa Xòe, giao lưu và tìm hiểu nét văn hóa đặc sắc của dân tộc Thái (chương trình biểu diễn dành tặng cho đoàn từ 20 khách trở lên). Nghỉ đêm tại Nghĩa Lộ Ngày 6: Quý khách dùng bữa sáng, trả phòng khách sạn và khởi hành tham quan: Đền Hùng: nơi thờ các vua Hùng có công dựng nước, tổ tiên của dân tộc Việt Nam, một quần thể kiến trúc thâm nghiêm trên núi Nghĩa Lĩnh. Quý khách dâng hương đất tổ, thăm quan đền Thượng, đền Trung, đền Hạ, Giếng Ngọc, Lăng vua Hùng.Nghỉ đêm tại Hà Nội Ngày 7: Quý khách ăn sáng và trả phòng. Tiếp tục hành trình đến sân bay Nội Bài, Hướng dẫn viên hỗ trợ Quý khách làm thủ tục đáp chuyến bay về Tp.HCM. Chia tay Quý khách và kết thúc chương trình du lịch tại sân bay Tân Sơn Nhất. KẾT THÚC CHƯƠNG TRÌNH, CẢM ƠN VÀ TẠM BIỆT QUÝ KHÁCH!*Lưu ý:Hành trình có thể thay đổi thứ tự điểm đến tùy vào điều kiện thực tế. Lịch trình tham quan (tắm biển, ngắm hoa, trải nghiệm,...) rất dễ bị ảnh hưởng bởi thời tiết. Đây là trường hợp bất khả kháng mong Quý khách hiểu và thông cảm.Khách Sạn có thể ở xa trung tâm thành phố vào các mùa Cao Điểm. Cơ cấu phòng sẽ phụ thuộc vào tình hình thực tế của khách sạn khi làm thủ tục nhận phòng. Vietravel hỗ trợ 1 bữa ăn nhẹ tại sân bay đối với các chuyến bay về sau 20:00 tối."])</script><script>self.__next_f.push([1,"e:[[\"$\",\"meta\",\"0\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}],[\"$\",\"meta\",\"1\",{\"charSet\":\"utf-8\"}],[\"$\",\"title\",\"2\",{\"children\":\"Đặt tour Khám phá Tây Bắc| Hòa Bình - Mộc Châu - Điện Biên - Lai Châu - Sapa - Fansipan - Yên Bái - Hà Nội | Tặng vé tàu hỏa leo núi Mường Hoa cùng Vietravel\"}],[\"$\",\"meta\",\"3\",{\"name\":\"description\",\"content\":\"$20\"}],[\"$\",\"link\",\"4\",{\"rel\":\"manifest\",\"href\":\"/manifest.webmanifest\",\"crossOrigin\":\"use-credentials\"}],[\"$\",\"meta\",\"5\",{\"name\":\"keywords\",\"content\":\"Du lịch, Du lịch giá rẻ, , Khám phá Tây Bắc| Hòa Bình - Mộc Châu - Điện Biên - Lai Châu - Sapa - Fansipan - Yên Bái - Hà Nội | Tặng vé tàu hỏa leo núi Mường Hoa\"}],[\"$\",\"meta\",\"6\",{\"name\":\"category\",\"content\":\"tour quốc tế\"}],[\"$\",\"link\",\"7\",{\"rel\":\"canonical\",\"href\":\"https://localhost:3727/chuong-trinh/kham-pha-tay-bac-hoa-binh-moc-chau-ien-bien-lai-chau-sapa-fansipan-yen-bai-ha-noi-tang-ve-tau-hoa-leo-nui-muong-hoa-pid-13057\"}],[\"$\",\"meta\",\"8\",{\"property\":\"og:title\",\"content\":\"Đặt tour Khám phá Tây Bắc| Hòa Bình - Mộc Châu - Điện Biên - Lai Châu - Sapa - Fansipan - Yên Bái - Hà Nội | Tặng vé tàu hỏa leo núi Mường Hoa cùng Vietravel\"}],[\"$\",\"meta\",\"9\",{\"property\":\"og:description\",\"content\":\"$21\"}],[\"$\",\"meta\",\"10\",{\"property\":\"og:site_name\",\"content\":\"Vietravel - Du lịch trong nước và quốc tế\"}],[\"$\",\"meta\",\"11\",{\"property\":\"og:image\",\"content\":\"https://media.travel.com.vn/Tour/tfd__1_13057_ethnic-minority-children-playing-in-the-plum-blossom-garden-in-full-bloom.webp\"}],[\"$\",\"meta\",\"12\",{\"property\":\"og:image:alt\",\"content\":\"Tphcm - Hà Nội - Bảo tàng Lịch sử Quân sự - Đèo Thung Khe - Mộc Châu\\t\"}],[\"$\",\"meta\",\"13\",{\"property\":\"og:image\",\"content\":\"https://media.travel.com.vn/Tour/tfd__1_13057_mcis-2.webp\"}],[\"$\",\"meta\",\"14\",{\"property\":\"og:image:alt\",\"content\":\"Mộc Châu - Tp. Sơn La - Điện Biên\"}],[\"$\",\"meta\",\"15\",{\"property\":\"og:image\",\"content\":\"https://media.travel.com.vn/Tour/tfd__0_13057_3-bao-tang-chien-thang-dien-bien-phu-da-in-xuan-tu.webp\"}],[\"$\",\"meta\",\"16\",{\"property\":\"og:image:alt\",\"content\":\"Điện Biên - Lai Châu\"}],[\"$\",\"meta\",\"17\",{\"property\":\"og:image\",\"content\":\"https://media.travel.com.vn/Tour/tfd__2_13057_cap-treo-fansipan.webp\"}],[\"$\",\"meta\",\"18\",{\"property\":\"og:image:alt\",\"content\":\"Lai Châu - Sapa\"}],[\"$\",\"meta\",\"19\",{\"property\":\"og:image\",\"content\":\"https://media.travel.com.vn/Tour/tfd__1_13057_hmong-ethnic-minority-women-walking-on-rice-terraces.webp\"}],[\"$\",\"meta\",\"20\",{\"property\":\"og:image:alt\",\"content\":\"Sapa - Mù Cang Chải - Nghĩa Lộ\"}],[\"$\",\"meta\",\"21\",{\"property\":\"og:image\",\"content\":\"https://media.travel.com.vn/Tour/tfd__1_13057_le-hoi-den-hung.webp\"}],[\"$\",\"meta\",\"22\",{\"property\":\"og:image:alt\",\"content\":\"Nghĩa Lộ - Yên Bái - Hà Nội\"}],[\"$\",\"meta\",\"23\",{\"property\":\"og:image\",\"content\":\"https://media.travel.com.vn/Tour/