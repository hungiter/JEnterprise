\":\"Nơi cấp\",\"journey\":\"Hành trình\",\"kid\":\"Trẻ nhỏ\",\"kidDescription\":\"Từ 2 - 4 tuổi\",\"LandPrice\":\"Land Tour\",\"language\":\"Ngôn ngữ\",\"lastDeal\":\"Ưu đãi giờ chót\",\"lastMinuteDealTour\":\"Tour ưu đãi giờ chót\",\"lastMinuteTourDescription\":\"Du lịch giờ chót của Vietravel luôn đem đến cho Quý khách những niềm bất ngờ thú vị. Đó là những đường tour cuốn hút với mức giá đầy hấp dẫn, khuyến mại vào thời điểm cận ngày đi. Với những giảm giá rất ưu đãi phối hợp với hệ thống đối tác lớn mạnh, Vietravel cho Quý khách cơ hội được tận hưởng những dịch vụ chất lượng vàng không đổi từ công ty lữ hành uy tín nhất Việt Nam.\",\"lastName\":\"Họ\",\"learnMore\":\"Tìm hiểu thêm\",\"loading\":\"Đang tải dữ liệu\",\"localMeetInfo\":\"Thông tin tập trung\",\"localMeetPlace\":\"Địa điểm tập trung\",\"localMeetTime\":\"Thời gian tập trung\",\"location\":\"Vị trí\",\"locationReviewPoint\":\"Điểm đánh giá vị trí\",\"locations\":\"Hành trình\",\"login\":\"Đăng nhập\",\"loginFor\":\"Để nhận ưu đãi, tích điểm và quản lý đơn hàng dễ dàng hơn!\",\"logout\":\"Đăng xuất\",\"male\":\"Nam\",\"maxLengthWarning\":\"Đã đạt đến giới hạn ký tự\",\"meansOfTransportation\":\"Phương tiện di chuyển\",\"middleAndFirstName\":\"Tên đệm và tên\",\"month\":\"Tháng\",\"more\":\"Thêm\",\"moreInfo\":\"Thông tin thêm\",\"moveBack\":\"Trở về\",\"nationalId\":\"CMND/CCCD\",\"nationality\":\"Quốc tịch\",\"nationalityPlaceholder\":\"Vui lòng chọn quốc tịch\",\"network\":\"Mạng lưới\",\"newNews\":\"Tin mới\",\"next\":\"Tiếp theo\",\"night\":\"Đ\",\"nightBeforeDay1\":\"Buổi chiều trước ngày 1\",\"nights\":\"Đ\",\"no\":\"Không\",\"noFoundResultMatchLabel\":\"Hiện tại chưa có kết quả tìm kiếm phù hợp.\",\"noPriceInfoFound\":\"Không tìm thấy thông tin giá\",\"noRelatedInfo\":\"Không có thông tin liên quan\",\"note\":\"Ghi chú\",\"noted\":\"Lưu ý\",\"notification\":\"Thông báo\",\"numberOfAvailable\":\"Số chỗ còn nhận\",\"numbOfNight\":\"Số đêm\",\"numOfPax\":\"Số lượng hành khách\",\"onlineBookingOff