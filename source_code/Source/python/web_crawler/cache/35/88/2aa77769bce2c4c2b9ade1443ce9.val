m.\",\"iHavePlan\":\"Tôi đã có dự định\",\"infoDetail\":\"Thông tin chi tiết khách sạn\",\"needExtraBedsWillCharge\":\"Cần đặt thêm một giường phụ và sẽ phụ thu thêm.\",\"night\":\"Đêm\",\"noteCancelTimeZone\":\"Lưu ý: Thời gian hủy phòng được tính theo múi giờ tại địa phương của khách sạn\",\"noteDescription\":{\"detail\":\" Quý khách có yêu cầu đặc biệt? Gửi yêu cầu và khách sạn sẽ cố gắng đáp ứng nguyện vọng của Quý khách. Xin lưu ý yêu cầu đặc biệt không được bảo đảm trước và có thể thu phí\",\"title\":\"Quý khách có thêm yêu cầu gì về khách sạn hãy nói với chúng tôi\"},\"optionHotelSort\":{\"0\":\"Khách sạn mới nhất\",\"1\":\"Giá từ thấp đến cao\",\"2\":\"Giá từ cao đến thấp\",\"3\":\"Số sao từ thấp đến cao\",\"4\":\"Số sao từ cao đến thấp\"},\"othersPolicy\":\"Quy định khác\",\"priced\":\"Thành tiền\",\"pricePerNight\":\"Giá mỗi đêm\",\"room\":\"Phòng\",\"roomList\":\"Danh sách phòng\",\"searchHotel\":\"Tìm kiếm khách sạn\",\"seeRoom\":\"Xem phòng\",\"selectedRoom\":\"Phòng đã chọn\",\"selectRoom\":\"Chọn phòng\",\"stayFreeIfUsingExistBed\":\"Ở miễn phí nếu sử dụng giường có sẵn\",\"taxesAndServiceFees\":\"Thuế và phí dịch vụ\",\"taxesAndServiceFeesDescription\":\"Thuế và phí dịch vụ là chi phí thu hồi mà Vietravel trả cho nhà cung cấp hoặc sẽ được nhà cung cấp thu lại. Chi phí này đã bao gồm chi phí do Vietravel giữ lại để xứ lý đặt phòng.\",\"totalRoomPrice\":\"Tổng tiền phòng\",\"typeOfAccommodation\":\"Loại hình chỗ ở\",\"waitForPartnerConfirmBooking\":\"Đang chờ đối tác khách sạn xác nhận mã đặt phòng\",\"whenBookingMoreThan5Rooms\":\"Khi đặt trên 5 phòng, chính sách và điều khoản bổ sung có thể được áp dụng.\",\"whenYouCheckIn\":\"Quý khách đã biết khi nào sẽ đến nhận phòng chưa?\"},\"language\":{\"country\":{\"china\":\"Trung Quốc\",\"france\":\"Pháp\",\"germany\":\"Đức\",\"global\":\"Quốc tế\",\"japan\":\"Nhật Bản\",\"korea\":\"Hàn Quốc\",\"spain\":\"Tây Ban Nha\",\"thailand\":\"Thái Lan\",\"vietnam\":\"Việt Nam\"},\"lang\":{\"chinese\":\"Tiếng Trung\"