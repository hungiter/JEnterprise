ngleRoomForThisPax\":\"Phòng đơn cho hành khách này\",\"sort\":\"Sắp xếp\",\"sortBy\":\"Sắp xếp theo\",\"standard\":\"Tiêu chuẩn\",\"starRating\":\"Xếp hạng sao\",\"startDate\":\"Ngày đi\",\"subTotal\":\"Tạm tính\",\"suitableSubject\":\"Đối tượng thích hợp\",\"summary\":\"Tóm tắt\",\"surcharge\":\"Phụ thu\",\"taxCode\":\"Mã số thuế\",\"taxesAndFees\":\"Thuế và các khoản phí\",\"taxesFeesOthers\":\"Thuế, phí, các dịch vụ khác\",\"termsAndConditions\":\"Điều khoản và điều kiện\",\"ticketQty\":\"Số lượng vé\",\"time\":\"Thời gian\",\"timeGo\":\"Giờ đi\",\"timePickReturnCar\":\"Chọn giờ nhận - trả xe\",\"toDate\":\"đến\",\"toReceive\":\"Để nhận được\",\"toReceivePromotion\":\"để nhận được {title} tiết kiệm thêm \",\"total\":\"Tổng cộng\",\"totalAmount\":\"Tổng tiền\",\"totalCheckedBaggage\":\"Tổng hành lý ký gửi\",\"totalPrice\":\"Tổng tiền\",\"totalShort\":\"Tổng\",\"tour\":\"Tour du lịch\",\"tourClass\":\"Dòng tour\",\"tourCode\":\"Mã tour\",\"tourGuideInfo\":\"Thông tin hướng dẫn viên\",\"tourism\":\"Du lịch\",\"tourNotAvailableApologize\":\"Rất tiếc hiện tại chương trình này Vietravel chưa lên lịch khởi hành! Mời Quý khách chọn chương trình khác \u003crelated\u003etour\u003c/related\u003e.\",\"tourPrice\":\"Giá tour\",\"tourPriceInclude\":\"Giá tour bao gồm\",\"tourPriceNotInclude\":\"Giá tour không bao gồm\",\"tourProgram\":\"Chương trình tour\",\"tourProgramForYou\":\"Chương trình tour cho quý khách\",\"tourSelectedReason\":\"Lý do chọn tour\",\"tranferOrCancelTourNote\":\"Lưu ý khi chuyển/hủy tour\",\"transportation\":\"Phương tiện\",\"travelEverywhere\":\"Du lịch mọi nơi cùng Vietravel\",\"travelExperienceVietnameAndWorld\":\"Kinh nghiệm du lịch Việt Nam và thế giới\",\"travelHandBookVietNamAndWorld\":\"Cẩm nang du lịch Việt Nam và thế giới\",\"travelNewsVietnamAndWorld\":\"Tin tức du lịch Việt Nam và thế giới\",\"travelWithVietravel\":\"Du lịch cùng Vietravel\",\"type\":\"Loại\",\"underNoYearOld\":\"Dưới {max} tuổi\",\"unitPrice\":\"Đơn giá\",\"unknown\":\"Không rõ\",\"updateRentalInfoLabel\":\"Cập nhật thông tin thuê xe\",\"updateSuccess\":\"Cập nhật thông tin thành công\",\"updating\":\"Đang cập nhật\",\"use\":\"Sử dụng\",\"useDate\":\"Ngày sử dụng\",\"vat\":\"Thuế GTGT\",\"vehicleInfo\":\"Thông tin phương tiện\",\"vietravel\":\"Vietravel\",\"vietravelNo1TravelCompany\":\"Vietravel là công ty lữ hành số 1 Việt Nam, chuyên tổ chức các tour du lịch nước ngoài, với gần 1.000 tuyến khắp 5 châu. Bạn sẽ có dịp khám phá những miền đất mới tại các nước Đông Nam Á, Châu Á, châu Âu, Úc, Mỹ, hay khám phá những vùng đất Châu Phi xa xôi... Với lịch trình dày, khởi hành đúng thời gian cam kết, Vietravel là công ty lữ hành uy tín nhất hiện nay tại Việt Nam, luôn sẵn sàng phục vụ du khách mọi lúc, mọi nơi, đảm bảo tính chuyên nghiệp và chất lượng dịch vụ tốt nhất thị trường.\",\"viewAll\":\"Xem tất cả\",\"viewDetail\":\"Xem chi tiết\",\"viewResult\":\"Xem kết quả\",\"visa\":\"Visa\",\"visaInfo\":\"Thông tin Visa\",\"waitForEnter\":\"Đang chờ nhập\",\"warningPaymentMethod\":\"Quý khách xác nhận thanh toán bằng {payments}?\",\"weekdayCancelConditions\":\"Các điều kiện hủy tour đối với ngày thường\",\"weFound\":\"Chúng tôi tìm thấy\",\"weWillContactSoon\":\"sẽ liên hệ Quý khách trong thời gian sớm nhất để hỗ trợ. Quý khách vui lòng chú ý điện thoại và email như đã đăng ký.\",\"whereDoYouWantToGo\":\"Bạn muốn đi đâu?\",\"withAdditionalCharge\":\"Có phụ phí\",\"yearOld\":\"Tuổi\",\"yes\":\"Có\",\"youCanLeaveThisPage\":\"Bạn có thể rời khỏi trang này\",\"youWillExperience\":\"Bạn sẽ trải nghiệm\",\"youWillHaveSingleRoom\":\"Quý khách sẽ được ở một phòng đơn\"},\"contact\":{\"amountToInvoice\":\"Nhập số tiền cần xuất hóa đơn\",\"companyName\":\"Tên công ty\",\"content\":\"Nội dung\",\"customerName\":\"Nhập tên người mua hàng\",\"description\":\"Để có thể đáp ứng được các yêu cầu và đóng góp ý kiến của quý khách, xin vui lòng gửi thông tin hoặc gọi đến hotline các chi nhánh bên dưới để liên hệ một cách nhanh chóng\",\"enterAddress\":\"Nhập địa